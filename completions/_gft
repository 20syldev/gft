#compdef gft gfv

# Zsh completion for gft
# Install to /usr/share/zsh/vendor-completions/_gft

_gft() {
    local -a subcommands
    subcommands=(
        'update:Upgrade gft to the latest version'
        'delete:Uninstall gft'
        'uninstall:Uninstall gft'
        'stash:Manage git stashes in the current repo'
    )

    if (( CURRENT == 2 )); then
        _alternative \
            'subcommands:subcommand:compadd -a subcommands' \
            'repos:repository (user/repo):'
        return
    fi

    if (( CURRENT == 3 )) && [[ "${words[2]}" == stash ]]; then
        _values 'stash action' list ls show diff drop rm clean clear
        return
    fi

    # After "--" every word is a repository or tag.
    if (( ${words[(I)--]} > 0 && ${words[(I)--]} < CURRENT )); then
        return
    fi

    _arguments \
        '1:repository (user/repo):' \
        '2:tag or version range:' \
        '--assets[List release binary assets]' \
        '--detect[Auto-detect OS/arch and suggest assets]' \
        '--get[Download asset matching a grep pattern]:pattern:' \
        '--asset=[Download the asset with exactly this file name]:asset name:' \
        '--install[Download, extract and install binary]' \
        '--user[With --install: install to ~/.local/bin]' \
        '--force[Replace an existing file]' \
        '--plain[One entry per line with --releases or --assets]' \
        '--releases[List all available releases]' \
        '--list[List all available releases]' \
        '--source=[Download source archive non-interactively]:format:(zip tar)' \
        '--checksum=-[Verify download checksum]::enabled:(true false)' \
        '--verify=-[Verify download checksum]::enabled:(true false)' \
        '--notes[Show release notes]' \
        '--json[Output as JSON]' \
        '--pre=-[Include pre-releases when resolving latest]::enabled:(true false)' \
        '--prerelease=-[Include pre-releases when resolving latest]::enabled:(true false)' \
        '--open[Open release page in browser]' \
        '--dir=[Write downloads and the installed binary to this folder]:folder:_files -/' \
        '(-q --quiet)'{-q,--quiet}'[Output version only]' \
        '(-h --help)'{-h,--help}'[Show help]' \
        '(-v --version)'{-v,--version}'[Show version]' \
        '--check-update[Check for newer version]' \
        '--upgrade[Upgrade gft to latest version]' \
        '--no-color[Disable colors]' \
        '--no-cache=-[Bypass response cache]::enabled:(true false)' \
        '--clear-cache[Clear all cached responses]'
}

_gft "$@"
