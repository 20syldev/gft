#!/bin/bash

# gft - GitHub Fetch Tool
# Fetch release info, assets, and downloads from any GitHub project
# Usage: gft <user/repo> [tag] [options]

set -e

# Bash 5.2 reads "&" in a ${var//pattern/replacement} as the matched text; keep it literal.
shopt -u patsub_replacement 2>/dev/null || true

GFT_DIR="$HOME/.config/gft"
CACHE_DIR="$GFT_DIR/cache"
CACHE_TTL="${GFT_CACHE_TTL:-300}"
# Kept in sync with the VERSION file by the release bump.
VERSION="1.1.0"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[1;94m'
YELLOW='\033[1;33m'
CYAN='\033[1;36m'
MAGENTA='\033[1;35m'
NC='\033[0m'

# Unicode symbols (no emojis)
SYM_OK="\xe2\x9c\x93"       # ✓
SYM_FAIL="\xe2\x9c\x97"     # ✗
SYM_ARROW="\xe2\x86\x92"    # →
SYM_ARROW_L="\xe2\x86\x90"  # ←
SYM_BULLET=">"              # section header
SYM_DOT="-"                 # info line
SYM_DASH="\xe2\x94\x80"     # ─
SYM_TEE="\xe2\x94\x9c"      # ├
SYM_CORNER="\xe2\x94\x94"   # └
SYM_VLINE="\xe2\x94\x82"    # │

# ─── Color support ───────────────────────────────────────────────────

setup_colors() {
    if [[ -n "${NO_COLOR:-}" ]] || [[ ! -t 1 ]]; then
        RED='' GREEN='' BLUE='' YELLOW='' CYAN='' MAGENTA='' NC=''
    fi
}

# ─── Spinner ─────────────────────────────────────────────────────────

# Spinner frames for animation.
SPIN_FRAMES=(
    "\xe2\xa0\x8b" "\xe2\xa0\x99" "\xe2\xa0\xb9" "\xe2\xa0\xb8" "\xe2\xa0\xbc"
    "\xe2\xa0\xb4" "\xe2\xa0\xa6" "\xe2\xa0\xa7" "\xe2\xa0\x87" "\xe2\xa0\x8f"
)
SPIN_DELAY="0.08"
SPIN_PID=""

spinner_supported() {
    [[ -z "${GFT_NO_SPINNER:-}" ]] && [[ -t 2 ]]
}

spinner_start() {
    spinner_supported || return 0
    local msg="$1"
    printf '\033[?25l' >&2
    (
        trap 'exit 0' TERM
        local i=0
        while :; do
            printf "\r${CYAN}%b${NC} %s" \
                "${SPIN_FRAMES[i % ${#SPIN_FRAMES[@]}]}" "$msg" >&2
            i=$(( i + 1 ))
            sleep "$SPIN_DELAY"
        done
    ) &
    SPIN_PID=$!
}

spinner_stop() {
    if [[ -n "$SPIN_PID" ]]; then
        kill "$SPIN_PID" 2>/dev/null || true
        wait "$SPIN_PID" 2>/dev/null || true
        SPIN_PID=""
    fi
    spinner_supported || return 0
    printf '\r\033[K\033[?25h' >&2
}

# ─── Symbol fallback ────────────────────────────────────────

# Expand a SYM_* escape sequence to the bytes it stands for.
sym() { printf '%b' "$1"; }

# Set up symbols based on terminal capabilities and environment variables.
setup_symbols() {
    local charset="${LC_ALL:-${LC_CTYPE:-${LANG:-}}}"
    if [[ -z "${GFT_ASCII:-}" ]] && [[ "$charset" =~ [Uu][Tt][Ff]-?8 ]]; then
        return 0
    fi
    SYM_OK="[ok]"
    SYM_FAIL="[!]"
    SYM_ARROW="->"
    SYM_ARROW_L="<-"
    SYM_DASH="-"
    SYM_TEE="|"
    SYM_CORNER='`'
    SYM_VLINE="|"
    SPIN_FRAMES=("-" "\\\\" "|" "/")
}

# Depends only on the environment, so it can settle once at startup.
setup_symbols

trap 'spinner_stop; exit 130' INT
trap 'spinner_stop; exit 143' TERM

