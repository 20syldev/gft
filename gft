# ─── Self-update check ───────────────────────────────────────────────

GFT_REPO="20syldev/gft"
CDN="https://cdn.sylvain.sh/bash"

# Print -1, 0 or 1 when version $1 is older than, equal to or newer than $2.
version_cmp() {
    local a="${1#v}" b="${2#v}" pa pb i n x y
    local -a va vb
    a="${a%%+*}" b="${b%%+*}"
    pa="${a#*-}"; [[ "$pa" == "$a" ]] && pa=""
    pb="${b#*-}"; [[ "$pb" == "$b" ]] && pb=""
    IFS=. read -ra va <<< "${a%%-*}"
    IFS=. read -ra vb <<< "${b%%-*}"
    n=$(( ${#va[@]} > ${#vb[@]} ? ${#va[@]} : ${#vb[@]} ))
    for (( i = 0; i < n; i++ )); do
        x="${va[i]:-0}" y="${vb[i]:-0}"
        x="${x//[!0-9]/}" y="${y//[!0-9]/}"
        x=$(( 10#${x:-0} )) y=$(( 10#${y:-0} ))
        (( x > y )) && { echo 1; return 0; }
        (( x < y )) && { echo -1; return 0; }
    done
    # Same release: a pre-release sorts before the release, identifiers compare one by one.
    [[ "$pa" == "$pb" ]] && { echo 0; return 0; }
    [[ -z "$pa" ]] && { echo 1; return 0; }
    [[ -z "$pb" ]] && { echo -1; return 0; }
    IFS=. read -ra va <<< "$pa"
    IFS=. read -ra vb <<< "$pb"
    n=$(( ${#va[@]} > ${#vb[@]} ? ${#va[@]} : ${#vb[@]} ))
    for (( i = 0; i < n; i++ )); do
        x="${va[i]:-}" y="${vb[i]:-}"
        [[ "$x" == "$y" ]] && continue
        [[ -z "$x" ]] && { echo -1; return 0; }
        [[ -z "$y" ]] && { echo 1; return 0; }
        if [[ "$x" =~ ^[0-9]+$ && "$y" =~ ^[0-9]+$ ]]; then
            (( 10#$x > 10#$y )) && { echo 1; return 0; }
            echo -1; return 0
        fi
        [[ "$x" =~ ^[0-9]+$ ]] && { echo -1; return 0; }
        [[ "$y" =~ ^[0-9]+$ ]] && { echo 1; return 0; }
        [[ "$x" > "$y" ]] && { echo 1; return 0; }
        echo -1; return 0
    done
    echo 0
}

# Read the marker written by the apt package, found next to the real script (../share/gft).
INSTALL_METHOD="" INSTALL_PKG=""
read_install_method() {
    local real marker key val
    real=$(readlink -f "$0" 2>/dev/null) || real=""
    [[ -n "$real" ]] || real="$0"
    marker="$(dirname "$real")/../share/gft/install-method"
    [[ -f "$marker" ]] || return 0
    while IFS='=' read -r key val || [[ -n "$key" ]]; do
        case "$key" in
            install_method) INSTALL_METHOD="$val" ;;
            package) INSTALL_PKG="$val" ;;
        esac
    done < "$marker"
}

# Print how to $1 (upgrade or remove) gft through apt, preceded by a header unless $2 is "brief".
install_hint() {
    if [[ "${2:-}" != "brief" ]]; then
        echo -e "${YELLOW}${SYM_FAIL} gft is managed by apt${NC}"
        echo
    fi
    if [[ "$1" == "upgrade" ]]; then
        if [[ "$INSTALL_PKG" == "deb" ]]; then
            echo -e "  ${BLUE}Download:${NC}   https://github.com/$GFT_REPO/releases/latest"
            echo -e "  ${BLUE}Upgrade:${NC}    ${CYAN}sudo apt install ./gft_<version>_all.deb${NC}"
        else
            echo -e "  ${BLUE}Upgrade:${NC}    ${CYAN}sudo apt update && sudo apt upgrade gft${NC}"
        fi
    else
        echo -e "  ${BLUE}Remove:${NC}     ${CYAN}sudo apt remove gft${NC}"
    fi
}

check_update() {
    spinner_start "Checking for updates..."

    local latest
    latest=$(curl -sL --max-time 5 "https://github.com/$GFT_REPO/releases" 2>/dev/null \
        | grep -o 'href="[^"]*/releases/tag/[^"]*"' | head -1 | sed 's/.*\/tag\///; s/".*//')
    spinner_stop

    if [[ -z "$latest" ]]; then
        echo -e "${YELLOW}${SYM_FAIL} Could not check for updates${NC}"
        return 1
    fi

    case "$(version_cmp "$VERSION" "$latest")" in
        0)
            echo -e "${GREEN}${SYM_OK} gft ${VERSION} is up to date${NC}"
            ;;
        1)
            echo -e "${GREEN}${SYM_OK} gft ${VERSION} is newer than the latest release (${latest})${NC}"
            ;;
        *)
            echo -e "${YELLOW}${SYM_BULLET} Update available: ${CYAN}${VERSION}${NC} ${SYM_ARROW} ${GREEN}${latest}${NC}"
            echo
            read_install_method
            if [[ "$INSTALL_METHOD" == "apt" ]]; then
                install_hint upgrade brief
            else
                echo -e "  ${BLUE}Upgrade:${NC}    ${CYAN}gft --upgrade${NC}"
            fi
            echo -e "  ${BLUE}Release:${NC}    https://github.com/$GFT_REPO/releases/tag/$latest"
            ;;
    esac
}

self_upgrade() {
    read_install_method
    if [[ "$INSTALL_METHOD" == "apt" ]]; then
        install_hint upgrade
        return 1
    fi

    spinner_start "Fetching latest version..."

    local latest
    latest=$(curl -fsSL --max-time 10 "${CDN}/gft@latest" 2>/dev/null \
        | grep -o '"version": *"[^"]*"' | head -1 | cut -d'"' -f4)
    spinner_stop

    if [[ -z "$latest" ]]; then
        echo -e "${RED}${SYM_FAIL} Could not fetch latest version${NC}"
        return 1
    fi

    case "$(version_cmp "$VERSION" "$latest")" in
        0)
            echo -e "${GREEN}${SYM_OK} gft ${VERSION} is already up to date${NC}"
            return 0
            ;;
        1)
            echo -e "${GREEN}${SYM_OK} gft ${VERSION} is newer than the latest release (${latest})${NC}"
            return 0
            ;;
    esac

    echo -e "${SYM_ARROW} Upgrading ${CYAN}${VERSION}${NC} ${SYM_ARROW} ${GREEN}${latest}${NC}..."

    local tmp_file
    tmp_file=$(mktemp)

    spinner_start "Downloading gft ${latest}..."
    if curl -fsSL --max-time 30 "${CDN}/gft@${latest}/gft" -o "$tmp_file"; then
        spinner_stop
        chmod +x "$tmp_file"
        mv "$tmp_file" "$GFT_DIR/gft"
        echo "$latest" > "$GFT_DIR/VERSION"
        echo -e "${GREEN}${SYM_OK} gft upgraded to ${latest}${NC}"
    else
        spinner_stop
        rm -f "$tmp_file"
        echo -e "${RED}${SYM_FAIL} Download failed${NC}"
        return 1
    fi

    for comp_dir in /usr/share/bash-completion/completions "$HOME/.local/share/bash-completion/completions"; do
        if [ -f "$comp_dir/gft" ]; then
            curl -fsSL --max-time 10 "${CDN}/gft@${latest}/completions/gft.bash" \
                -o "$comp_dir/gft" 2>/dev/null \
                && echo -e "${GREEN}${SYM_OK} Bash completion updated${NC}"
            break
        fi
    done

    for comp_dir in /usr/share/zsh/vendor-completions "$HOME/.local/share/zsh/site-functions"; do
        if [ -f "$comp_dir/_gft" ]; then
            curl -fsSL --max-time 10 "${CDN}/gft@${latest}/completions/_gft" \
                -o "$comp_dir/_gft" 2>/dev/null \
                && echo -e "${GREEN}${SYM_OK} Zsh completion updated${NC}"
            break
        fi
    done

    for man_dir in /usr/local/share/man/man1 "$HOME/.local/share/man/man1"; do
        if [ -f "$man_dir/gft.1" ]; then
            curl -fsSL --max-time 10 "${CDN}/gft@${latest}/gft.1" \
                -o "$man_dir/gft.1" 2>/dev/null \
                && echo -e "${GREEN}${SYM_OK} Manpage updated${NC}"
            break
        fi
    done
}

self_uninstall() {
    read_install_method
    if [[ "$INSTALL_METHOD" == "apt" ]]; then
        install_hint remove
        return 1
    fi

    echo -e "${BLUE}gft uninstaller${NC}\n"

    if [[ ! -d "$GFT_DIR" ]]; then
        echo -e "${YELLOW}gft is not installed.${NC}"
        return 0
    fi

    echo -e "${RED}This will remove gft.${NC}"
    printf "${CYAN}Continue? [y/N]:${NC} "
    read -r CONFIRM < /dev/tty
    case "$CONFIRM" in
        y|Y|yes|YES|oui|OUI) ;;
        *) echo -e "${BLUE}Cancelled.${NC}"; return 0 ;;
    esac

    echo

    for bin_dir in /usr/local/bin "$HOME/.local/bin" "$HOME/bin"; do
        if [[ -L "$bin_dir/gft" ]]; then
            rm -f "$bin_dir/gft"
            echo -e "${GREEN}${SYM_OK} Removed symlink:${NC} $bin_dir/gft"
        fi
        if [[ -L "$bin_dir/gfv" ]]; then
            rm -f "$bin_dir/gfv"
            echo -e "${GREEN}${SYM_OK} Removed symlink:${NC} $bin_dir/gfv"
        fi
    done

    rm -f "$GFT_DIR/gft"
    rm -f "$GFT_DIR/VERSION"
    rm -rf "$GFT_DIR/cache"
    rmdir "$GFT_DIR" 2>/dev/null && echo -e "${GREEN}${SYM_OK} Removed:${NC} $GFT_DIR"

    for comp in /usr/share/bash-completion/completions/gft "$HOME/.local/share/bash-completion/completions/gft"; do
        if [[ -f "$comp" ]]; then
            rm -f "$comp"
            echo -e "${GREEN}${SYM_OK} Removed:${NC} $comp"
        fi
    done

    for comp in /usr/share/zsh/vendor-completions/_gft "$HOME/.local/share/zsh/site-functions/_gft"; do
        if [[ -f "$comp" ]]; then
            rm -f "$comp"
            echo -e "${GREEN}${SYM_OK} Removed:${NC} $comp"
        fi
    done

    for man in /usr/local/share/man/man1/gft.1 "$HOME/.local/share/man/man1/gft.1"; do
        if [[ -f "$man" ]]; then
            rm -f "$man"
            echo -e "${GREEN}${SYM_OK} Removed:${NC} $man"
        fi
    done

    for rc in "$HOME/.bashrc" "$HOME/.bash_profile" "$HOME/.profile" "$HOME/.zshrc"; do
        if [[ -f "$rc" ]] && grep -q "# Added by gft installer" "$rc"; then
            sed -i '/# Added by gft installer/d;/export PATH=.*gft/d' "$rc"
            echo -e "${GREEN}${SYM_OK} Cleaned:${NC} $rc"
        fi
    done

    echo
    echo -e "${GREEN}${SYM_OK} Done!${NC} gft has been uninstalled."
    echo -e "${YELLOW}Reload your shell to apply changes.${NC}"
}

# ─── Cache utilities ─────────────────────────────────────────────────

file_mtime() {
    stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null
}

cache_key() {
    printf '%s' "$1" | tr -cs 'a-zA-Z0-9._-' '_'
}

cache_fetch() {
    local url="$1"
    local key
    key=$(cache_key "$url")
    local cache_file="$CACHE_DIR/$key"

    if [[ "${NO_CACHE:-false}" != true ]] && [[ -f "$cache_file" ]]; then
        local now mtime age
        now=$(date +%s)
        mtime=$(file_mtime "$cache_file")
        if [[ -n "$mtime" ]]; then
            age=$(( now - mtime ))
            if [[ $age -lt $CACHE_TTL ]]; then
                cat "$cache_file"
                return 0
            fi
        fi
    fi

    local content
    spinner_start "Fetching ${url#https://}..."
    content=$(curl -sL --max-time 10 "$url" 2>/dev/null)
    spinner_stop

    if [[ "${NO_CACHE:-false}" != true ]] && [[ -n "$content" ]]; then
        mkdir -p "$CACHE_DIR"
        printf '%s' "$content" > "$cache_file"
    fi

    printf '%s' "$content"
}

# ─── Fetch utilities ─────────────────────────────────────────────────

fetch_page() {
    cache_fetch "$1"
}

fetch_api() {
    local endpoint="$1"
    local out

    spinner_start "Querying GitHub API..."
    # Try gh cli first if available and authenticated
    if command -v gh &>/dev/null && gh auth status &>/dev/null 2>&1; then
        if out=$(gh api "$endpoint" 2>/dev/null); then
            spinner_stop
            printf '%s' "$out"
            return 0
        fi
    fi
    # Fallback to curl with optional token
    local headers=()
    if [[ -n "${GITHUB_TOKEN:-}" ]]; then
        headers=(-H "Authorization: token $GITHUB_TOKEN")
    fi
    out=$(curl -sL --max-time 10 "${headers[@]}" \
        "https://api.github.com/$endpoint" 2>/dev/null) || true
    spinner_stop
    printf '%s' "$out"
}

# ─── Repository checks ──────────────────────────────────────────────

check_repository_exists() {
    local repo_url="https://github.com/$REPO"
    local response

    spinner_start "Checking repository..."
    response=$(curl -s -o /dev/null -w "%{http_code}" "$repo_url" 2>/dev/null)
    spinner_stop

    if [ "$response" = "200" ]; then
        return 0
    elif [ "$response" = "404" ]; then
        {
            echo -e "${RED}${SYM_FAIL} Repository not found:${NC} $REPO"
            echo -e "  Expected format: ${YELLOW}username/repository${NC}"
            echo -e "  Example: ${YELLOW}nodejs/node${NC}"
        } >&"$MSG_FD"
        exit 1
    else
        echo -e "${YELLOW}${SYM_FAIL} Unable to verify repository (HTTP $response)${NC}" >&"$MSG_FD"
        return 1
    fi
}

# ─── Tag resolution ──────────────────────────────────────────────────

get_latest_tag() {
    if [[ "${MODE_PRE:-false}" == true ]]; then
        # Include pre-releases: take first entry from /releases
        local response
        response=$(fetch_page "https://github.com/$REPO/releases")
        if [[ -n "$response" ]]; then
            local found_tag
            found_tag=$(echo "$response" \
                | grep -o 'href="[^"]*/releases/tag/[^"]*"' | head -1 \
                | sed 's/.*\/tag\///; s/".*//')
            if [[ -n "$found_tag" ]]; then
                echo "$found_tag"
                return 0
            fi
        fi
    else
        # Stable only: follow /releases/latest redirect
        local resolved
        resolved=$(curl -sL --max-time 10 -o /dev/null -w '%{url_effective}' \
            "https://github.com/$REPO/releases/latest" 2>/dev/null)
        local found_tag
        found_tag=$(echo "$resolved" | grep -oP '/releases/tag/\K[^/?]+') || true
        if [[ -n "$found_tag" ]]; then
            echo "$found_tag"
            return 0
        fi

        # Fallback: scrape /releases
        local response
        response=$(fetch_page "https://github.com/$REPO/releases")
        if [[ -n "$response" ]]; then
            found_tag=$(echo "$response" \
                | grep -o 'href="[^"]*/releases/tag/[^"]*"' | head -1 \
                | sed 's/.*\/tag\///; s/".*//')
            if [[ -n "$found_tag" ]]; then
                echo "$found_tag"
                return 0
            fi
        fi
    fi

    return 1
}

resolve_tag() {
    local silent=false
    if [[ "${MODE_QUIET:-false}" == true ]] || [[ "${MODE_JSON:-false}" == true ]]; then
        silent=true
    fi

    if [ "$TAG" = "latest" ]; then
        local latest_tag
        latest_tag=$(get_latest_tag) || true
        if [ -n "$latest_tag" ]; then
            TAG="$latest_tag"
            if [[ "$silent" != true ]]; then
                echo -e "${GREEN}${SYM_OK} Latest release: ${YELLOW}$TAG${NC}"
            fi
        else
            if [[ "$silent" != true ]]; then
                echo -e "${YELLOW}${SYM_FAIL} No release tag found${NC}"
                echo -e "  ${CYAN}${SYM_BULLET} Check: https://github.com/$REPO/releases${NC}"
            fi
            TAG="main"
            NO_RELEASE=true
        fi
    else
        if [[ "$silent" != true ]]; then
            echo -e "${GREEN}${SYM_OK} Tag: ${YELLOW}$TAG${NC}"
        fi
    fi
}

build_urls() {
    REPO_URL="https://github.com/$REPO"
    RELEASES_URL="$REPO_URL/releases"
    if [ "$TAG" != "main" ] && [ "$TAG" != "master" ]; then
        TAG_URL="$REPO_URL/releases/tag/$TAG"
        ZIP_URL="$REPO_URL/archive/refs/tags/${TAG}.zip"
        TARBALL_URL="$REPO_URL/archive/refs/tags/${TAG}.tar.gz"
    else
        TAG_URL="$REPO_URL/tree/$TAG"
        ZIP_URL="$REPO_URL/archive/refs/heads/${TAG}.zip"
        TARBALL_URL="$REPO_URL/archive/refs/heads/${TAG}.tar.gz"
    fi
}

# ─── Display functions ───────────────────────────────────────────────

display_info() {
    echo
    echo -e "${SYM_DOT} ${BLUE}Repository:${NC}  $REPO"
    echo -e "${SYM_DOT} ${BLUE}Tag:${NC}         $TAG"
    echo

    echo -e "${YELLOW}${SYM_BULLET} Links${NC}"
    echo -e "  ${SYM_TEE}${SYM_DASH} ${BLUE}Repository:${NC}   $REPO_URL"
    echo -e "  ${SYM_TEE}${SYM_DASH} ${BLUE}Releases:${NC}     $RELEASES_URL"
    if [ "$TAG" != "main" ] && [ "$TAG" != "master" ]; then
        echo -e "  ${SYM_CORNER}${SYM_DASH} ${BLUE}This release:${NC} $TAG_URL"
    else
        echo -e "  ${SYM_CORNER}${SYM_DASH} ${BLUE}Branch:${NC}       $TAG_URL"
    fi

    echo
    echo -e "${YELLOW}${SYM_BULLET} Source Archives${NC}"
    echo -e "  ${SYM_TEE}${SYM_DASH} ${BLUE}ZIP:${NC}    $ZIP_URL"
    echo -e "  ${SYM_CORNER}${SYM_DASH} ${BLUE}TAR.GZ:${NC} $TARBALL_URL"

    echo
    echo -e "${YELLOW}${SYM_BULLET} Quick Commands${NC}"
    echo -e "  ${SYM_TEE}${SYM_DASH} ${CYAN}curl -LO \"$ZIP_URL\"${NC}"
    echo -e "  ${SYM_TEE}${SYM_DASH} ${CYAN}curl -LO \"$TARBALL_URL\"${NC}"
    if [ "$TAG" != "main" ] && [ "$TAG" != "master" ]; then
        echo -e "  ${SYM_CORNER}${SYM_DASH} ${CYAN}git clone --depth 1 --branch $TAG $REPO_URL.git${NC}"
    else
        echo -e "  ${SYM_CORNER}${SYM_DASH} ${CYAN}git clone $REPO_URL.git${NC}"
    fi

    if [ "$TAG" != "main" ] && [ "$TAG" != "master" ]; then
        echo
        echo -e "${CYAN}${SYM_BULLET} API details:${NC} curl -s \"https://api.github.com/repos/$REPO/releases/tags/$TAG\""
    fi
}

# ─── Assets listing ──────────────────────────────────────────────────

get_assets() {
    local assets_url="https://github.com/$REPO/releases/expanded_assets/$TAG"
    local response
    response=$(fetch_page "$assets_url")

    if [[ -z "$response" ]]; then
        return 1
    fi

    echo "$response" | grep -oP 'href="\K/[^"]+/releases/download/[^"]+' | sort -u
}

list_assets() {
    local assets
    assets=$(get_assets) || true

    if [[ -z "$assets" ]]; then
        echo -e "${YELLOW}${SYM_FAIL} No binary assets found for this release${NC}"
        echo -e "  Source archives are still available in the default view"
        return 0
    fi

    echo
    echo -e "${YELLOW}${SYM_BULLET} Release Assets ($TAG)${NC}"
    echo

    local count=0
    while IFS= read -r asset_path; do
        if [[ -z "$asset_path" ]]; then continue; fi
        local filename
        filename=$(basename "$asset_path")
        ((count++)) || true

        if [[ "${MODE_DETECT:-false}" == true ]]; then
            local match
            match=$(highlight_asset "$filename")
            if [[ "$match" == "match" ]]; then
                printf "  ${GREEN}${SYM_OK} %2d) %s  ${CYAN}${SYM_ARROW_L} recommended${NC}\n" "$count" "$filename"
            else
                printf "  %4d) %s\n" "$count" "$filename"
            fi
        else
            printf "  %4d) %s\n" "$count" "$filename"
        fi
    done <<< "$assets"

    echo
    echo -e "  ${GREEN}${count} asset(s) available${NC}"
}

# ─── Releases listing ────────────────────────────────────────────────

# First 10 releases as tag, name, published_at, prerelease rows (\037-separated).
releases_from_api() {
    gh_ready || return 1
    local rows
    rows=$(gh_tsv "repos/$REPO/releases?per_page=20" \
        '[.[] | select(.draft | not)][:10][]
         | [.tag_name, .name // "", .published_at // "", (.prerelease | tostring)] | @tsv') \
        || return 1

    local tag name published prerelease
    while IFS=$'\037' read -r tag name published prerelease; do
        [[ -z "$tag" ]] && continue
        tag=$(tsv_unescape "$tag")
        name=$(trim "$(tsv_unescape "$name")")
        [[ -n "$name" ]] || name=$(trim "$(api_tag_subject "$tag")")
        printf '%s\037%s\037%s\037%s\n' "$tag" "$name" "$published" "$prerelease"
    done <<< "$rows"
}

releases_from_web() {
    local page
    page=$(fetch_page "https://github.com/$REPO/releases")
    [[ -n "$page" ]] || return 1

    # One <section id="release-..."> per release: its title link, first ISO date and labels.
    local rows
    rows=$(printf '%s' "$page" | awk '
        function flush() {
            if (tag != "") print tag "\037" name "\037" date "\037" pre
            tag = ""; name = ""; date = ""; pre = "false"
        }
        /<section id="release-/ { flush(); insec = 1 }
        insec && tag == "" && match($0, /href="\/[^"]+\/releases\/tag\/[^"]+"[^>]*class="Link--primary Link">[^<]*</) {
            link = substr($0, RSTART, RLENGTH)
            t = link; sub(/^href="\/[^"]+\/releases\/tag\//, "", t); sub(/".*/, "", t)
            n = link; sub(/^[^>]*>/, "", n); sub(/<$/, "", n)
            tag = t; name = n
        }
        insec && date == "" && match($0, /<relative-time[^>]*datetime="[0-9-]+T[0-9:]+Z"/) {
            d = substr($0, RSTART, RLENGTH); sub(/.*datetime="/, "", d); sub(/"$/, "", d)
            date = d
        }
        insec && /class="Label Label--warning[^"]*">Pre-release</ { pre = "true" }
        END { flush() }
    ') || true

    local tag name published prerelease
    while IFS=$'\037' read -r tag name published prerelease; do
        [[ -z "$tag" ]] && continue
        printf '%s\037%s\037%s\037%s\n' "$(url_decode "$tag")" "$(trim "$(html_decode "$name")")" \
            "$published" "$prerelease"
    done <<< "$rows"
}

releases_json() {
    local rows
    if ! rows=$(releases_from_api); then
        if ! rows=$(releases_from_web); then
            echo "gft: could not fetch releases for $REPO" >&2
            exit 1
        fi
    fi

    json_setup
    local n=$J_NL s=$J_SEP
    if [[ -z "$rows" ]]; then
        printf '[]\n'
        return 0
    fi

    printf '[%s' "$n"
    local tag name published prerelease first=true
    while IFS=$'\037' read -r tag name published prerelease; do
        [[ -z "$tag" ]] && continue
        [[ "$prerelease" == true ]] || prerelease=false
        [[ -n "$name" ]] || name="$tag"
        $first || printf ',%s' "$n"
        first=false
        printf '%s{%s' "$J_I1" "$n"
        printf '%s"tag"%s%s,%s' "$J_I2" "$s" "$(json_str "$tag")" "$n"
        printf '%s"name"%s%s,%s' "$J_I2" "$s" "$(json_str "$name")" "$n"
        printf '%s"published_at"%s%s,%s' "$J_I2" "$s" "$(json_str_or_null "$published")" "$n"
        printf '%s"prerelease"%s%s%s' "$J_I2" "$s" "$prerelease" "$n"
        printf '%s}' "$J_I1"
    done <<< "$rows"
    printf '%s]\n' "$n"
}

list_releases() {
    if [[ "${MODE_JSON:-false}" == true ]]; then
        releases_json
        return 0
    fi

    local releases_url="https://github.com/$REPO/releases"
    local response
    response=$(fetch_page "$releases_url")

    if [[ -z "$response" ]]; then
        echo -e "${RED}${SYM_FAIL} Could not fetch releases page${NC}"
        return 1
    fi

    local all_tags
    all_tags=$(echo "$response" \
        | grep -oP 'href="/[^"]+/releases/tag/\K[^"]+' \
        | grep -v '^#' \
        | awk '!seen[$0]++')

    if [[ -z "$all_tags" ]]; then
        echo -e "${YELLOW}${SYM_FAIL} No releases found for $REPO${NC}"
        return 0
    fi

    echo
    echo -e "${YELLOW}${SYM_BULLET} Releases ($REPO)${NC}"
    echo

    local count=0
    while IFS= read -r tag; do
        ((count++)) || true
        printf "  ${SYM_TEE}${SYM_DASH} ${CYAN}%s${NC}\n" "$tag"
    done <<< "$all_tags"

    echo
    echo -e "  ${GREEN}${count} release(s) shown${NC} ${SYM_ARROW} https://github.com/$REPO/releases"
    if [[ "${MODE_PRE:-false}" != true ]]; then
        echo -e "  ${CYAN}Tip:${NC} use ${YELLOW}--pre${NC} to include pre-releases when resolving latest"
    fi
}

# ─── Platform detection ──────────────────────────────────────────────

detect_platform() {
    local os arch
    os=$(uname -s | tr '[:upper:]' '[:lower:]')
    arch=$(uname -m)

    case "$os" in
        linux)           OS_PATTERNS=("linux") ;;
        darwin)          OS_PATTERNS=("darwin" "macos" "mac" "osx" "apple") ;;
        mingw*|msys*|cygwin*) OS_PATTERNS=("windows" "win" "win64" "win32") ;;
        freebsd)         OS_PATTERNS=("freebsd") ;;
        *)               OS_PATTERNS=("$os") ;;
    esac

    case "$arch" in
        x86_64|amd64)    ARCH_PATTERNS=("amd64" "x86_64" "x64" "64bit") ;;
        aarch64|arm64)   ARCH_PATTERNS=("arm64" "aarch64") ;;
        armv7l|armhf)    ARCH_PATTERNS=("armv7" "armhf" "arm") ;;
        i686|i386)       ARCH_PATTERNS=("386" "i386" "i686" "x86" "32bit") ;;
        *)               ARCH_PATTERNS=("$arch") ;;
    esac
}

highlight_asset() {
    local filename="$1"
    local filename_lower
    filename_lower=$(echo "$filename" | tr '[:upper:]' '[:lower:]')
    local os_match=false arch_match=false

    for pattern in "${OS_PATTERNS[@]}"; do
        local p_lower
        p_lower=$(echo "$pattern" | tr '[:upper:]' '[:lower:]')
        [[ "$filename_lower" == *"$p_lower"* ]] && os_match=true && break
    done

    for pattern in "${ARCH_PATTERNS[@]}"; do
        local p_lower
        p_lower=$(echo "$pattern" | tr '[:upper:]' '[:lower:]')
        [[ "$filename_lower" == *"$p_lower"* ]] && arch_match=true && break
    done

    if $os_match && $arch_match; then
        echo "match"
    fi
}

# ─── Release notes ───────────────────────────────────────────────────

show_release_notes() {
    # Try gh cli first for cleaner output
    if command -v gh &>/dev/null && gh auth status &>/dev/null 2>&1; then
        local notes
        notes=$(gh api "repos/$REPO/releases/tags/$TAG" --jq '.body' 2>/dev/null) || true
        if [[ -n "$notes" ]]; then
            echo
            echo -e "${YELLOW}${SYM_BULLET} Release Notes ($TAG)${NC}"
            local separator
            separator=$(printf "%0.s$(sym "$SYM_DASH")" {1..40})
            echo -e "${CYAN}${separator}${NC}"
            echo "$notes" | head -80
            echo -e "${CYAN}${separator}${NC}"
            return 0
        fi
    fi

    # Fallback: scrape the release page
    local url="https://github.com/$REPO/releases/tag/$TAG"
    local response
    response=$(fetch_page "$url")

    if [[ -z "$response" ]]; then
        echo -e "${RED}${SYM_FAIL} Could not fetch release page${NC}"
        return 1
    fi

    local notes
    notes=$(echo "$response" | \
        sed -n '/data-test-selector="body-content"/,/<\/div>/p' | \
        sed 's/<[^>]*>//g' | \
        sed 's/&amp;/\&/g; s/&lt;/</g; s/&gt;/>/g; s/&quot;/"/g' | \
        sed "s/&#39;/'/g" | \
        sed '/^[[:space:]]*$/d' | \
        head -80)

    if [[ -z "$notes" ]]; then
        echo -e "${YELLOW}${SYM_FAIL} No release notes available for $TAG${NC}"
        return 0
    fi

    echo
    echo -e "${YELLOW}${SYM_BULLET} Release Notes ($TAG)${NC}"
    local separator
    separator=$(printf "%0.s$(sym "$SYM_DASH")" {1..40})
    echo -e "${CYAN}${separator}${NC}"
    echo "$notes"
    echo -e "${CYAN}${separator}${NC}"
}

# ─── JSON output ─────────────────────────────────────────────────────

# Schema 1 (see README): the same keys whether the data comes from the API (gh) or the web pages.
JSON_SCHEMA=1

# Compact on one line when stdout is not a terminal (scripts parse it), indented otherwise.
json_setup() {
    if [[ -t 1 ]]; then
        J_NL=$'\n' J_I1="  " J_I2="    " J_I3="      " J_SEP=": "
    else
        J_NL="" J_I1="" J_I2="" J_I3="" J_SEP=":"
    fi
}

# Quote a string as a JSON string literal.
json_str() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    s="${s//[[:cntrl:]]/}"
    printf '"%s"' "$s"
}

# Quote a string, or print null when it is empty.
json_str_or_null() {
    if [[ -n "$1" ]]; then json_str "$1"; else printf 'null'; fi
}

html_decode() {
    local s="$1"
    s="${s//&lt;/<}"
    s="${s//&gt;/>}"
    s="${s//&quot;/\"}"
    s="${s//&#39;/\'}"
    s="${s//&#x27;/\'}"
    s="${s//&amp;/&}"
    printf '%s' "$s"
}

url_decode() {
    printf '%b' "${1//%/\\x}"
}

trim() {
    local s="$1"
    s="${s#"${s%%[![:space:]]*}"}"
    s="${s%"${s##*[![:space:]]}"}"
    printf '%s' "$s"
}

# Title GitHub shows for an untitled release (unsigned annotated tag subject).
api_tag_subject() {
    local sha
    sha=$(gh api "repos/$REPO/git/ref/tags/$1" \
        --jq 'select(.object.type == "tag") | .object.sha' 2>/dev/null) || return 0
    [[ -n "$sha" ]] || return 0
    gh api "repos/$REPO/git/tags/$sha" \
        --jq 'select(.verification.reason == "unsigned") | .message | split("\n")[0]' \
        2>/dev/null || true
}

gh_ready() {
    command -v gh &>/dev/null && gh auth status &>/dev/null
}

# Run a gh api query whose jq filter emits @tsv rows, with \037 as separator.
gh_tsv() {
    local endpoint="$1" filter="$2" out
    out=$(gh api "$endpoint" --jq "$filter" 2>/dev/null) || return 1
    printf '%s\n' "$out" | tr '\t' '\037'
}

# Undo the escaping of a gh @tsv field.
tsv_unescape() {
    printf '%b' "$1"
}

# Release fields, filled by release_from_api or release_from_web.
R_NAME="" R_PUBLISHED="" R_PRERELEASE=false R_SOURCE=""
A_NAMES=() A_URLS=() A_DIGESTS=()

release_from_api() {
    gh_ready || return 1

    local rows
    rows=$(gh_tsv "repos/$REPO/releases/tags/$TAG" \
        '([.name // "", .published_at // "", (.prerelease | tostring)] | @tsv),
         (.assets | sort_by(.name)[] | [.name, .browser_download_url, .digest // ""] | @tsv)') \
        || return 1
    [[ -n "$rows" ]] || return 1

    local first=true name url digest published prerelease
    A_NAMES=() A_URLS=() A_DIGESTS=()
    while IFS=$'\037' read -r name url digest; do
        if $first; then
            published="$url" prerelease="$digest"
            R_NAME=$(trim "$(tsv_unescape "$name")")
            [[ -n "$R_NAME" ]] || R_NAME=$(trim "$(api_tag_subject "$TAG")")
            R_PUBLISHED="$published"
            R_PRERELEASE="$prerelease"
            first=false
            continue
        fi
        A_NAMES+=("$(tsv_unescape "$name")")
        A_URLS+=("$(tsv_unescape "$url")")
        A_DIGESTS+=("$digest")
    done <<< "$rows"

    [[ "$R_PRERELEASE" == true ]] || R_PRERELEASE=false
    R_SOURCE="api"
}

release_from_web() {
    local page
    page=$(fetch_page "https://github.com/$REPO/releases/tag/$TAG")

    # A release page has a visible title; a bare git tag or a 404 page does not.
    local title
    title=$(printf '%s' "$page" \
        | grep -oE '<h1 data-view-component="true" class="[^"]*d-inline">[^<]*</h1>' \
        | head -1 | sed 's/<[^>]*>//g') || true
    if [[ -z "$title" ]] && ! grep -qE '<h1 data-view-component="true" class="[^"]*d-inline">' \
        <<< "$page"; then
        return 1
    fi

    R_NAME=$(trim "$(html_decode "$title")")
    # The first ISO datetime on a release page is its publication date.
    R_PUBLISHED=$(printf '%s' "$page" \
        | grep -oE '<relative-time[^>]*datetime="[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:]{8}Z"' \
        | head -1 | sed 's/.*datetime="//; s/"$//') || true
    if grep -qE 'class="Label Label--warning[^"]*">Pre-release<' <<< "$page"; then
        R_PRERELEASE=true
    else
        R_PRERELEASE=false
    fi

    # One <li> per asset, holding its download link and, when GitHub has one, its digest.
    local assets_page rows
    assets_page=$(fetch_page "https://github.com/$REPO/releases/expanded_assets/$TAG")
    rows=$(printf '%s' "$assets_page" | awk '
        /<li/ { if (href != "") print href "\037" digest; href = ""; digest = "" }
        match($0, /href="\/[^"]+\/releases\/download\/[^"]+"/) {
            href = substr($0, RSTART + 6, RLENGTH - 7)
        }
        match($0, /sha256:[0-9a-f]+/) { if (digest == "") digest = substr($0, RSTART, RLENGTH) }
        END { if (href != "") print href "\037" digest }
    ' | sort -t$'\037' -k1,1 -u) || true

    local path digest name
    local -a entries=()
    A_NAMES=() A_URLS=() A_DIGESTS=()
    while IFS=$'\037' read -r path digest; do
        [[ -z "$path" ]] && continue
        name=$(url_decode "${path##*/}")
        # The API percent-encodes "+" in download URLs; the page keeps it raw in file names.
        entries+=("$name"$'\037'"https://github.com${path//+/%2B}"$'\037'"$digest")
    done <<< "$rows"

    # Sort by decoded name, as the API path does.
    if [[ ${#entries[@]} -gt 0 ]]; then
        while IFS=$'\037' read -r name path digest; do
            A_NAMES+=("$name")
            A_URLS+=("$path")
            A_DIGESTS+=("$digest")
        done < <(printf '%s\n' "${entries[@]}" | LC_ALL=C sort -t$'\037' -k1,1)
    fi

    R_SOURCE="web"
}

output_json() {
    if [[ "${NO_RELEASE:-false}" == true ]]; then
        echo "gft: no release found for $REPO" >&2
        exit 1
    fi

    if [[ "$TAG" == *%* ]]; then
        TAG=$(url_decode "$TAG")
        build_urls
    fi

    if ! release_from_api && ! release_from_web; then
        echo "gft: release not found: $REPO $TAG" >&2
        exit 1
    fi

    # A release without a title shows its tag on GitHub; do the same on both paths.
    [[ -n "$R_NAME" ]] || R_NAME="$TAG"

    json_setup
    local n=$J_NL s=$J_SEP
    printf '{%s' "$n"
    printf '%s"schema"%s%s,%s' "$J_I1" "$s" "$JSON_SCHEMA" "$n"
    printf '%s"repository"%s%s,%s' "$J_I1" "$s" "$(json_str "$REPO")" "$n"
    printf '%s"tag"%s%s,%s' "$J_I1" "$s" "$(json_str "$TAG")" "$n"
    printf '%s"name"%s%s,%s' "$J_I1" "$s" "$(json_str "$R_NAME")" "$n"
    printf '%s"published_at"%s%s,%s' "$J_I1" "$s" "$(json_str_or_null "$R_PUBLISHED")" "$n"
    printf '%s"prerelease"%s%s,%s' "$J_I1" "$s" "$R_PRERELEASE" "$n"
    printf '%s"release_url"%s%s,%s' "$J_I1" "$s" "$(json_str "$TAG_URL")" "$n"
    printf '%s"repo_url"%s%s,%s' "$J_I1" "$s" "$(json_str "$REPO_URL")" "$n"
    printf '%s"zip_url"%s%s,%s' "$J_I1" "$s" "$(json_str "$ZIP_URL")" "$n"
    printf '%s"tarball_url"%s%s,%s' "$J_I1" "$s" "$(json_str "$TARBALL_URL")" "$n"
    printf '%s"source"%s%s,%s' "$J_I1" "$s" "$(json_str "$R_SOURCE")" "$n"

    if [[ ${#A_NAMES[@]} -eq 0 ]]; then
        printf '%s"assets"%s[]%s' "$J_I1" "$s" "$n"
    else
        printf '%s"assets"%s[%s' "$J_I1" "$s" "$n"
        local i last=$(( ${#A_NAMES[@]} - 1 ))
        for i in "${!A_NAMES[@]}"; do
            printf '%s{%s' "$J_I2" "$n"
            printf '%s"name"%s%s,%s' "$J_I3" "$s" "$(json_str "${A_NAMES[i]}")" "$n"
            printf '%s"url"%s%s,%s' "$J_I3" "$s" "$(json_str "${A_URLS[i]}")" "$n"
            printf '%s"digest"%s%s%s' "$J_I3" "$s" "$(json_str_or_null "${A_DIGESTS[i]}")" "$n"
            printf '%s}' "$J_I2"
            [[ $i -lt $last ]] && printf ','
            printf '%s' "$n"
        done
        printf '%s]%s' "$J_I1" "$n"
    fi
    printf '}\n'
}

# ─── Checksum verification ───────────────────────────────────────────

sha256_cmd() {
    if command -v sha256sum &>/dev/null; then
        echo "sha256sum"
    elif command -v shasum &>/dev/null; then
        echo "shasum -a 256"
    else
        echo ""
    fi
}

find_checksum_asset() {
    local filename="$1"
    local assets="$2"
    local patterns=("${filename}.sha256" "${filename}.sha256sum" "${filename}.sha512"
                    "SHA256SUMS" "checksums.txt" "SHASUMS256.txt" "sha256sums.txt")

    for pattern in "${patterns[@]}"; do
        local match
        match=$(echo "$assets" | grep -iF "/$pattern" | head -1) || true
        if [[ -n "$match" ]]; then
            echo "$match"
            return 0
        fi
    done

    echo "$assets" | grep -iE '\.(sha256|sha512|sha256sum)$|checksums' | head -1 || true
}

verify_checksum() {
    local file="$1"
    local checksum_path="$2"
    local checksum_url="https://github.com${checksum_path}"
    local filename
    filename=$(basename "$file")

    echo -e "${SYM_ARROW} Verifying checksum..."

    local cmd
    cmd=$(sha256_cmd)
    if [[ -z "$cmd" ]]; then
        echo -e "${YELLOW}${SYM_FAIL} No sha256sum/shasum found, skipping verification${NC}"
        return 0
    fi

    local tmp_checksum
    tmp_checksum=$(mktemp)
    if ! curl -sL --max-time 10 "$checksum_url" -o "$tmp_checksum"; then
        rm -f "$tmp_checksum"
        echo -e "${YELLOW}${SYM_FAIL} Could not download checksum file, skipping${NC}"
        return 0
    fi

    local expected_hash
    expected_hash=$(grep -i "$filename" "$tmp_checksum" | awk '{print $1}' | head -1) || true
    rm -f "$tmp_checksum"

    if [[ -z "$expected_hash" ]]; then
        echo -e "${YELLOW}${SYM_FAIL} File not found in checksum list, skipping${NC}"
        return 0
    fi

    local actual_hash
    # $cmd is unquoted on purpose ("shasum -a 256"); the path stays one word.
    actual_hash=$($cmd "$file" | awk '{print $1}')

    if [[ "$actual_hash" == "$expected_hash" ]]; then
        echo -e "${GREEN}${SYM_OK} Checksum verified${NC}"
    else
        echo -e "${RED}${SYM_FAIL} Checksum mismatch!${NC}"
        echo -e "  Expected: ${CYAN}${expected_hash}${NC}"
        echo -e "  Got:      ${RED}${actual_hash}${NC}"
        return 1
    fi
}

# ─── Direct asset download ───────────────────────────────────────────

download_asset() {
    local pattern="$1"
    local assets
    assets=$(get_assets) || true

    if [[ -z "$assets" ]]; then
        echo -e "${RED}${SYM_FAIL} No release assets found${NC}"
        return 1
    fi

    local matches
    matches=$(echo "$assets" | grep -i "$pattern") || true

    local match_count=0
    if [[ -n "$matches" ]]; then
        match_count=$(echo "$matches" | wc -l)
    fi

    if [[ $match_count -eq 0 ]]; then
        echo -e "${RED}${SYM_FAIL} No assets found matching '${pattern}'${NC}"
        echo -e "  Use ${YELLOW}--assets${NC} to list available assets"
        return 1
    elif [[ $match_count -gt 1 ]]; then
        echo -e "${YELLOW}${SYM_BULLET} Multiple assets match '${pattern}':${NC}"
        local i=0
        while IFS= read -r match; do
            ((i++)) || true
            echo -e "  ${BLUE}${i}${NC}) $(basename "$match")"
        done <<< "$matches"
        echo
        read -p "Select (1-${i}): " -r selection
        matches=$(echo "$matches" | sed -n "${selection}p")
    fi

    local url="https://github.com${matches}"
    local filename dest
    filename=$(basename "$matches")
    dest=$(dest_path "$filename")

    echo -e "${SYM_ARROW} Downloading ${CYAN}${filename}${NC}..."
    if curl -L --progress-bar "$url" -o "$dest"; then
        echo -e "${GREEN}${SYM_OK} Downloaded: ${dest}${NC}"
    else
        echo -e "${RED}${SYM_FAIL} Download failed${NC}"
        return 1
    fi

    if [[ "${MODE_VERIFY:-false}" == true ]]; then
        local checksum_path
        checksum_path=$(find_checksum_asset "$filename" "$assets")
        if [[ -n "$checksum_path" ]]; then
            verify_checksum "$dest" "$checksum_path"
        else
            echo -e "${YELLOW}${SYM_FAIL} No checksum file found for ${filename}${NC}"
        fi
    fi
}

# Where a downloaded file goes: the --dir folder, or the working directory.
dest_path() {
    if [[ -n "$DL_DIR" ]]; then
        printf '%s/%s' "${DL_DIR%/}" "$1"
    else
        printf '%s' "$1"
    fi
}

# ─── Install asset ───────────────────────────────────────────────────

find_install_dir() {
    if [ -w "/usr/local/bin" ]; then
        echo "/usr/local/bin"
    elif mkdir -p "$HOME/.local/bin" 2>/dev/null; then
        echo "$HOME/.local/bin"
    else
        mkdir -p "$HOME/bin"
        echo "$HOME/bin"
    fi
}

install_asset() {
    local pattern="${1:-}"

    local assets
    assets=$(get_assets) || true

    if [[ -z "$assets" ]]; then
        echo -e "${RED}${SYM_FAIL} No release assets found${NC}"
        return 1
    fi

    local selected_path=""

    if [[ -n "$pattern" ]]; then
        selected_path=$(echo "$assets" | grep -i "$pattern" | head -1) || true
    else
        if [[ "${MODE_DETECT:-false}" != true ]]; then
            detect_platform
        fi
        while IFS= read -r asset_path; do
            local fname
            fname=$(basename "$asset_path")
            if [[ "$(highlight_asset "$fname")" == "match" ]]; then
                selected_path="$asset_path"
                break
            fi
        done <<< "$assets"
    fi

    if [[ -z "$selected_path" ]]; then
        echo -e "${RED}${SYM_FAIL} No suitable asset found${NC}"
        echo -e "  Use ${YELLOW}--detect${NC} to see what's available, or ${YELLOW}--get <pattern>${NC} to specify"
        return 1
    fi

    local filename
    filename=$(basename "$selected_path")
    local url="https://github.com${selected_path}"

    # The download and its extraction stay in a temporary folder: only the binary is written out.
    local tmp_dir
    tmp_dir=$(mktemp -d)
    # shellcheck disable=SC2064
    trap "rm -rf '$tmp_dir'" EXIT
    local archive="$tmp_dir/$filename"
    local extract_dir="$tmp_dir/extract"
    mkdir "$extract_dir"

    echo -e "${SYM_ARROW} Downloading ${CYAN}${filename}${NC}..."
    if ! curl -L --progress-bar "$url" -o "$archive"; then
        echo -e "${RED}${SYM_FAIL} Download failed${NC}"
        return 1
    fi
    echo -e "${GREEN}${SYM_OK} Downloaded: ${filename}${NC}"

    if [[ "${MODE_VERIFY:-false}" == true ]]; then
        local checksum_path
        checksum_path=$(find_checksum_asset "$filename" "$assets")
        if [[ -n "$checksum_path" ]]; then
            verify_checksum "$archive" "$checksum_path" || return 1
        else
            echo -e "${YELLOW}${SYM_FAIL} No checksum file found, proceeding without verification${NC}"
        fi
    fi

    local binary_path=""

    case "$filename" in
        *.tar.gz|*.tgz)
            echo -e "${SYM_ARROW} Extracting archive..."
            if ! tar xzf "$archive" -C "$extract_dir" 2>/dev/null; then
                echo -e "${RED}${SYM_FAIL} Extraction failed${NC}"
                return 1
            fi
            ;;
        *.zip)
            echo -e "${SYM_ARROW} Extracting archive..."
            if ! command -v unzip &>/dev/null; then
                echo -e "${RED}${SYM_FAIL} unzip is required to extract .zip files${NC}"
                return 1
            fi
            if ! unzip -q "$archive" -d "$extract_dir" 2>/dev/null; then
                echo -e "${RED}${SYM_FAIL} Extraction failed${NC}"
                return 1
            fi
            ;;
        *)
            binary_path="$archive"
            chmod +x "$binary_path"
            ;;
    esac

    if [[ -z "$binary_path" ]]; then
        local repo_name
        repo_name=$(echo "$REPO" | cut -d'/' -f2 | tr '[:upper:]' '[:lower:]')
        binary_path=$(find "$extract_dir" -type f -name "$repo_name" 2>/dev/null | head -1) || true
        if [[ -z "$binary_path" ]]; then
            binary_path=$(find "$extract_dir" -type f -perm /111 \
                ! -path "*/__MACOSX/*" ! -name "*.sh" ! -name "*.md" \
                2>/dev/null | head -1) || true
        fi
        if [[ -z "$binary_path" ]]; then
            echo -e "${RED}${SYM_FAIL} No executable binary found in archive${NC}"
            return 1
        fi
    fi

    local install_dir
    if [[ -n "$DL_DIR" ]]; then
        install_dir="${DL_DIR%/}"
    else
        install_dir=$(find_install_dir)
    fi
    local binary_name
    binary_name=$(basename "$binary_path")

    echo -e "${SYM_ARROW} Installing ${CYAN}${binary_name}${NC} to ${CYAN}${install_dir:-/}${NC}..."
    if cp "$binary_path" "$install_dir/$binary_name" && chmod +x "$install_dir/$binary_name"; then
        echo -e "${GREEN}${SYM_OK} Installed: ${install_dir}/${binary_name}${NC}"
    else
        echo -e "${RED}${SYM_FAIL} Installation failed (permission denied?)${NC}"
        return 1
    fi

    trap - EXIT
    rm -rf "$tmp_dir"
}

# ─── Open in browser ─────────────────────────────────────────────────

open_url() {
    local url="$1"

    if grep -qi microsoft /proc/version 2>/dev/null; then
        if command -v wslview &>/dev/null; then
            wslview "$url" 2>/dev/null &
        else
            cmd.exe /c start "$url" 2>/dev/null &
        fi
        echo -e "${GREEN}${SYM_OK} Opening ${CYAN}${url}${NC}"
        return 0
    fi

    local os
    os=$(uname -s)
    case "$os" in
        Darwin)
            open "$url" 2>/dev/null &
            echo -e "${GREEN}${SYM_OK} Opening ${CYAN}${url}${NC}"
            ;;
        Linux)
            if [[ -z "${DISPLAY:-}" ]] && [[ -z "${WAYLAND_DISPLAY:-}" ]]; then
                echo -e "${YELLOW}${SYM_FAIL} No display detected, cannot open browser${NC}"
                echo -e "  URL: ${CYAN}${url}${NC}"
                return 1
            fi
            xdg-open "$url" 2>/dev/null &
            echo -e "${GREEN}${SYM_OK} Opening ${CYAN}${url}${NC}"
            ;;
        *)
            echo -e "${YELLOW}${SYM_FAIL} Cannot open browser on this platform${NC}"
            echo -e "  URL: ${CYAN}${url}${NC}"
            return 1
            ;;
    esac
}

# ─── Version comparison ──────────────────────────────────────────────

compare_releases() {
    local from="$1" to="$2"

    echo -e "${YELLOW}${SYM_BULLET} Comparing: ${CYAN}${from}${NC} ${SYM_ARROW} ${CYAN}${to}${NC}"
    echo

    # Fetch releases page to find tags in range
    local releases_page
    releases_page=$(fetch_page "https://github.com/$REPO/releases")

    if [[ -n "$releases_page" ]]; then
        local all_tags
        all_tags=$(echo "$releases_page" | grep -oP '/releases/tag/\K[^"]+' | head -50)

        if [[ -n "$all_tags" ]]; then
            local in_range=false
            local count=0
            echo -e "${BLUE}Releases in range:${NC}"
            while IFS= read -r tag; do
                if [[ "$tag" == "$to" ]]; then in_range=true; fi
                if $in_range; then
                    ((count++)) || true
                    echo -e "  ${SYM_TEE}${SYM_DASH} ${CYAN}${tag}${NC}"
                    if [[ "$tag" == "$from" ]]; then break; fi
                fi
            done <<< "$all_tags"

            if [[ $count -eq 0 ]]; then
                echo -e "  ${YELLOW}Could not find both tags on the first releases page${NC}"
            fi
        fi
    fi

    echo
    echo -e "${YELLOW}${SYM_BULLET} Compare on GitHub:${NC}"
    echo -e "  ${CYAN}https://github.com/$REPO/compare/${from}...${to}${NC}"
}

# ─── Interactive download ────────────────────────────────────────────

prompt_download() {
    echo
    read -p "$(echo -e "${YELLOW}${SYM_ARROW} Download? ${NC}(z)ip, (t)ar.gz, (n)o [n]: ")" -n 1 -r
    echo

    local dest
    if [[ $REPLY =~ ^[Zz]$ ]]; then
        echo -e "${SYM_ARROW} Downloading ZIP archive..."
        dest=$(dest_path "$(basename "$ZIP_URL")")
        if curl -L "$ZIP_URL" -o "$dest" 2>/dev/null; then
            echo -e "${GREEN}${SYM_OK} Downloaded: ${dest}${NC}"
        else
            echo -e "${RED}${SYM_FAIL} Download failed${NC}"
        fi
    elif [[ $REPLY =~ ^[Tt]$ ]]; then
        echo -e "${SYM_ARROW} Downloading TAR.GZ archive..."
        dest=$(dest_path "$(basename "$TARBALL_URL")")
        if curl -L "$TARBALL_URL" -o "$dest" 2>/dev/null; then
            echo -e "${GREEN}${SYM_OK} Downloaded: ${dest}${NC}"
        else
            echo -e "${RED}${SYM_FAIL} Download failed${NC}"
        fi
    fi
}

# ─── Git stash management ────────────────────────────────────────────

STASH_YES=false

stash_require_repo() {
    if ! git rev-parse --is-inside-work-tree &>/dev/null; then
        echo -e "${RED}${SYM_FAIL} Not a git repository${NC}"
        echo -e "  Run ${YELLOW}gft stash${NC} from inside a git repository"
        return 1
    fi
}

stash_list() {
    stash_require_repo || return 1

    local stashes
    stashes=$(git stash list --format='%gd%x09%gs' 2>/dev/null) || true

    if [[ -z "$stashes" ]]; then
        echo -e "${YELLOW}${SYM_FAIL} No stashes found${NC}"
        return 0
    fi

    echo
    echo -e "${YELLOW}${SYM_BULLET} Stashes${NC}"
    echo

    local total n=0 ref subj
    total=$(echo "$stashes" | wc -l)

    while IFS=$'\t' read -r ref subj; do
        [[ -z "$ref" ]] && continue
        ((n++)) || true
        if [[ $n -eq $total ]]; then
            echo -e "  ${SYM_CORNER}${SYM_DASH} ${CYAN}${ref}${NC}  ${subj}"
        else
            echo -e "  ${SYM_TEE}${SYM_DASH} ${CYAN}${ref}${NC}  ${subj}"
        fi
    done <<< "$stashes"

    echo
    echo -e "  ${GREEN}${total} stash(es)${NC}"
}

stash_show() {
    stash_require_repo || return 1

    local n="${1:-0}"
    local ref="stash@{${n}}"

    if ! git rev-parse --verify --quiet "$ref" >/dev/null 2>&1; then
        echo -e "${RED}${SYM_FAIL} No such stash: ${ref}${NC}"
        return 1
    fi

    git stash show -p "$ref"
}

stash_drop() {
    stash_require_repo || return 1

    local n="${1:-}"
    if [[ -z "$n" ]]; then
        echo -e "${RED}${SYM_FAIL} Usage: gft stash drop <index>${NC}"
        return 1
    fi

    local ref="stash@{${n}}"

    if ! git rev-parse --verify --quiet "$ref" >/dev/null 2>&1; then
        echo -e "${RED}${SYM_FAIL} No such stash: ${ref}${NC}"
        return 1
    fi

    if [[ "$STASH_YES" != true ]]; then
        printf "${CYAN}Drop ${ref}? [y/N]:${NC} "
        read -r reply < /dev/tty
        case "$reply" in
            y|Y|yes|YES|oui|OUI) ;;
            *) echo -e "${BLUE}Cancelled.${NC}"; return 0 ;;
        esac
    fi

    if git stash drop "$ref"; then
        echo -e "${GREEN}${SYM_OK} Dropped ${ref}${NC}"
    else
        echo -e "${RED}${SYM_FAIL} Failed to drop ${ref}${NC}"
        return 1
    fi
}

stash_clean() {
    stash_require_repo || return 1

    local count
    count=$(git stash list 2>/dev/null | wc -l | tr -d ' ')

    if [[ "$count" -eq 0 ]]; then
        echo -e "${YELLOW}${SYM_FAIL} No stashes found${NC}"
        return 0
    fi

    if [[ "$STASH_YES" != true ]]; then
        echo -e "${RED}This will delete all ${count} stash(es).${NC}"
        printf "${CYAN}Continue? [y/N]:${NC} "
        read -r reply < /dev/tty
        case "$reply" in
            y|Y|yes|YES|oui|OUI) ;;
            *) echo -e "${BLUE}Cancelled.${NC}"; return 0 ;;
        esac
    fi

    if git stash clear; then
        echo -e "${GREEN}${SYM_OK} Cleared ${count} stash(es)${NC}"
    else
        echo -e "${RED}${SYM_FAIL} Failed to clear stashes${NC}"
        return 1
    fi
}

stash_help() {
    echo "Usage: gft stash [action] [options]"
    echo
    echo "Manage git stashes in the current repository."
    echo
    echo "Actions:"
    echo "  list (default)  List stashes in the current repo"
    echo "  show [n]        Show the diff of stash n (default: 0)"
    echo "  drop <n>        Drop stash n"
    echo "  clean           Delete all stashes (alias: clear)"
    echo
    echo "Options:"
    echo "  -y, --yes       Skip confirmation prompts"
    echo
    echo "Aliases: ls=list  diff=show  rm=drop"
}

cmd_stash() {
    local action="${1:-list}"
    shift || true

    STASH_YES=false
    local args=()
    for a in "$@"; do
        case "$a" in
            -y|--yes) STASH_YES=true ;;
            *) args+=("$a") ;;
        esac
    done

    case "$action" in
        list|ls)
            stash_list
            ;;
        show|diff)
            stash_show "${args[0]:-0}"
            ;;
        drop|rm)
            stash_drop "${args[0]:-}"
            ;;
        clean|clear)
            stash_clean
            ;;
        -h|--help|help)
            stash_help
            ;;
        *)
            echo -e "${RED}${SYM_FAIL} Unknown stash action: ${action}${NC}"
            echo
            stash_help
            return 1
            ;;
    esac
}

# ─── Argument parsing ────────────────────────────────────────────────

REPO=""
TAG="latest"
NO_RELEASE=false
MSG_FD=1
DL_DIR=""
MODE_QUIET=false
MODE_ASSETS=false
MODE_DETECT=false
MODE_GET=false
MODE_NOTES=false
MODE_JSON=false
MODE_COMPARE=false
MODE_PRE=false
MODE_LIST=false
MODE_SOURCE=""
MODE_VERIFY=false
MODE_INSTALL=false
MODE_OPEN=false
NO_CACHE=false
GET_PATTERN=""
TAG_FROM=""
TAG_TO=""

# Commands are only recognised as the first argument.
case "${1:-}" in
    update)
        setup_colors
        self_upgrade
        exit $?
        ;;
    delete|uninstall)
        setup_colors
        self_uninstall
        exit $?
        ;;
    stash)
        setup_colors
        shift
        cmd_stash "$@"
        exit $?
        ;;
esac

add_positional() {
    if [ -z "$REPO" ]; then
        REPO="$1"
    elif [[ "$1" == *".."* ]]; then
        TAG_FROM="${1%%..*}"
        TAG_TO="${1##*..}"
        MODE_COMPARE=true
    else
        TAG="$1"
    fi
}

# With --json, usage errors from the loop below must not reach stdout either.
for arg in "$@"; do
    [[ "$arg" == "--" ]] && break
    if [[ "$arg" == "--json" ]]; then
        MSG_FD=2
        NO_COLOR=1
        setup_colors
        break
    fi
done

while [[ $# -gt 0 ]]; do
    case $1 in
        --)
            # End of options: everything after is a repository or tag.
            shift
            while [[ $# -gt 0 ]]; do
                add_positional "$1"
                shift
            done
            ;;
        -h|--help)
            show_help
            exit 0
            ;;
        -v|--version)
            echo "gft $VERSION"
            exit 0
            ;;
        --check-update)
            setup_colors
            check_update
            exit $?
            ;;
        --upgrade)
            setup_colors
            self_upgrade
            exit $?
            ;;
        --no-color)
            NO_COLOR=1
            shift
            ;;
        --no-cache)
            NO_CACHE=true
            shift
            ;;
        --open)
            MODE_OPEN=true
            shift
            ;;
        --install)
            MODE_INSTALL=true
            shift
            ;;
        --checksum|--verify)
            MODE_VERIFY=true
            shift
            ;;
        --source)
            MODE_SOURCE="${2:-}"
            if [[ -z "$MODE_SOURCE" ]]; then
                echo -e "${RED}${SYM_FAIL} --source requires an argument: zip or tar${NC}" >&"$MSG_FD"
                exit 1
            fi
            case "$MODE_SOURCE" in
                zip|tar|tar.gz|tarball) ;;
                *)
                    echo -e "${RED}${SYM_FAIL} --source argument must be 'zip' or 'tar'${NC}" >&"$MSG_FD"
                    exit 1
                    ;;
            esac
            shift 2
            ;;
        --releases|--list)
            MODE_LIST=true
            shift
            ;;
        --pre|--prerelease)
            MODE_PRE=true
            shift
            ;;
        --clear-cache)
            setup_colors
            if [[ -d "$CACHE_DIR" ]]; then
                rm -rf "$CACHE_DIR"
                echo -e "${GREEN}${SYM_OK} Cache cleared${NC}"
            else
                echo -e "${CYAN}${SYM_DOT} Cache is already empty${NC}"
            fi
            exit 0
            ;;
        -q|--quiet)
            MODE_QUIET=true
            NO_COLOR=1
            shift
            ;;
        --assets)
            MODE_ASSETS=true
            shift
            ;;
        --detect)
            MODE_DETECT=true
            MODE_ASSETS=true
            shift
            ;;
        --get)
            MODE_GET=true
            GET_PATTERN="${2:-}"
            if [[ -z "$GET_PATTERN" ]]; then
                echo -e "${RED}${SYM_FAIL} --get requires a pattern argument${NC}" >&"$MSG_FD"
                exit 1
            fi
            shift 2
            ;;
        --dir)
            DL_DIR="${2:-}"
            if [[ -z "$DL_DIR" ]]; then
                echo -e "${RED}${SYM_FAIL} --dir requires a folder argument${NC}" >&"$MSG_FD"
                exit 1
            fi
            shift 2
            ;;
        --notes)
            MODE_NOTES=true
            shift
            ;;
        --json)
            MODE_JSON=true
            NO_COLOR=1
            shift
            ;;
        -*)
            echo -e "${RED}${SYM_FAIL} Unknown option: $1${NC}" >&"$MSG_FD"
            show_help >&"$MSG_FD"
            exit 1
            ;;
        *)
            add_positional "$1"
            shift
            ;;
    esac
done

# Apply color settings after parsing
setup_colors

# Messages that are not the requested output go to stderr in JSON mode.
if [[ "$MODE_JSON" == true ]]; then
    MSG_FD=2
fi

# Validate repository argument
if [ -z "$REPO" ]; then
    show_help
    exit 0
fi

if [[ ! "$REPO" =~ ^[a-zA-Z0-9._-]+/[a-zA-Z0-9._-]+$ ]]; then
    {
        echo -e "${RED}${SYM_FAIL} Invalid repository format: '$REPO'${NC}"
        echo -e "  Expected: ${YELLOW}username/repository${NC}"
        echo -e "  Example:  ${YELLOW}nodejs/node${NC}"
    } >&"$MSG_FD"
    exit 1
fi

# Conflict checks
if [[ -n "$MODE_SOURCE" ]] && [[ "$MODE_GET" == true ]]; then
    echo -e "${RED}${SYM_FAIL} --source and --get cannot be used together${NC}" >&"$MSG_FD"
    exit 1
fi

# --dir is never created: a missing folder is more likely a typo than a wish.
if [[ -n "$DL_DIR" ]] && { [[ ! -d "$DL_DIR" ]] || [[ ! -w "$DL_DIR" ]]; }; then
    echo -e "${RED}${SYM_FAIL} --dir: not a writable folder: ${DL_DIR}${NC}" >&"$MSG_FD"
    exit 1
fi

# ─── Main flow ───────────────────────────────────────────────────────

# Init platform detection if needed
if [[ "$MODE_DETECT" == true ]]; then
    detect_platform
fi

if [[ "$MODE_QUIET" != true ]] && [[ "$MODE_JSON" != true ]]; then
    echo -e "${SYM_ARROW} Looking up ${YELLOW}$REPO${NC} (${CYAN}$TAG${NC})..."
fi

# Check repo exists
check_repository_exists

# Handle list mode
if [[ "$MODE_LIST" == true ]]; then
    list_releases
    exit 0
fi

# Handle compare mode separately
if [[ "$MODE_COMPARE" == true ]]; then
    echo
    compare_releases "$TAG_FROM" "$TAG_TO"
    exit 0
fi

# Resolve tag
resolve_tag

# Build URLs
build_urls

# Open in browser (combinable, does not exit)
if [[ "$MODE_OPEN" == true ]]; then
    open_url "$TAG_URL" >&"$MSG_FD"
fi

# Dispatch by mode
if [[ "$MODE_QUIET" == true ]]; then
    echo "$TAG"
    exit 0
fi

if [[ "$MODE_JSON" == true ]]; then
    output_json
    exit 0
fi

if [[ "$MODE_INSTALL" == true ]]; then
    install_asset "${GET_PATTERN:-}"
    exit 0
fi

if [[ "$MODE_GET" == true ]]; then
    download_asset "$GET_PATTERN"
    exit 0
fi

# Non-interactive source download
if [[ -n "$MODE_SOURCE" ]]; then
    dl_file=""
    case "$MODE_SOURCE" in
        zip)
            echo -e "${SYM_ARROW} Downloading ZIP source archive..."
            dl_file=$(dest_path "$(basename "$ZIP_URL")")
            if curl -L --progress-bar "$ZIP_URL" -o "$dl_file"; then
                echo -e "${GREEN}${SYM_OK} Downloaded: ${dl_file}${NC}"
            else
                echo -e "${RED}${SYM_FAIL} Download failed${NC}"
                exit 1
            fi
            ;;
        tar|tar.gz|tarball)
            echo -e "${SYM_ARROW} Downloading TAR.GZ source archive..."
            dl_file=$(dest_path "$(basename "$TARBALL_URL")")
            if curl -L --progress-bar "$TARBALL_URL" -o "$dl_file"; then
                echo -e "${GREEN}${SYM_OK} Downloaded: ${dl_file}${NC}"
            else
                echo -e "${RED}${SYM_FAIL} Download failed${NC}"
                exit 1
            fi
            ;;
    esac
    exit 0
fi

# Default display
display_info

# Append optional modes
if [[ "$MODE_ASSETS" == true ]]; then
    list_assets
fi

if [[ "$MODE_NOTES" == true ]]; then
    show_release_notes
fi

# Interactive download prompt (only in terminal, not piped)
if [[ -t 0 ]] && [[ "$MODE_ASSETS" != true ]] && [[ "$MODE_GET" != true ]]; then
    prompt_download
fi
