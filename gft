# ─── Assets listing ──────────────────────────────────────────────────

# A tag as an URL path part: # ? space and control bytes are encoded, existing %XX are kept.
tag_url() {
    local LC_ALL=C s="$1" out="" c h i
    for ((i = 0; i < ${#s}; i++)); do
        c="${s:i:1}"
        case "$c" in
            [A-Za-z0-9._~@+,:=\&\!\'\(\)\*\;\$/-]) out+="$c" ;;
            %)
                if [[ "${s:i+1:2}" =~ ^[0-9A-Fa-f]{2}$ ]]; then out+="%"; else out+="%25"; fi
                ;;
            *)
                printf -v h '%%%02X' "'$c"
                out+="$h"
                ;;
        esac
    done
    printf '%s' "$out"
}

get_assets() {
    local assets_url
    assets_url="https://github.com/$REPO/releases/expanded_assets/$(tag_url "$TAG")"
    local response rc=0
    response=$(fetch_page "$assets_url") || rc=$?

    # 2 is a failed fetch (only --plain tells it apart), 1 an empty page.
    [[ $rc -eq 0 ]] || return 2
    if [[ -z "$response" ]]; then
        return 1
    fi

    echo "$response" | grep -oP 'href="\K/[^"]+/releases/download/[^"]+' | sed 's/&amp;/\&/g' | LC_ALL=C sort -u
}

list_assets() {
    local assets
    assets=$(get_assets) || true

    if [[ -z "$assets" ]]; then
        echo -e "${YELLOW}${SYM_FAIL} No binary assets found for this release${NC}"
        echo -e "  Source archives are still available in the default view"
        return 0
    fi

    echo
    echo -e "${YELLOW}${SYM_BULLET} Release Assets ($TAG)${NC}"
    echo

    local count=0
    while IFS= read -r asset_path; do
        if [[ -z "$asset_path" ]]; then continue; fi
        local filename
        filename=$(basename "$asset_path")
        ((count++)) || true

        if [[ "${MODE_DETECT:-false}" == true ]]; then
            local match
            match=$(highlight_asset "$filename")
            if [[ "$match" == "match" ]]; then
                printf "  ${GREEN}${SYM_OK} %2d) %s  ${CYAN}${SYM_ARROW_L} recommended${NC}\n" "$count" "$filename"
            else
                printf "  %4d) %s\n" "$count" "$filename"
            fi
        else
            printf "  %4d) %s\n" "$count" "$filename"
        fi
    done <<< "$assets"

    echo
    echo -e "  ${GREEN}${count} asset(s) available${NC}"
}

# ─── Releases listing ────────────────────────────────────────────────

# First 10 releases as tag, name, published_at, prerelease rows (\037-separated).
releases_from_api() {
    gh_ready || return 1
    local rows
    rows=$(gh_tsv "repos/$REPO/releases?per_page=20" \
        '[.[] | select(.draft | not)][:10][]
         | [.tag_name, .name // "", .published_at // "", (.prerelease | tostring)] | @tsv') \
        || return 1

    local tag name published prerelease
    while IFS=$'\037' read -r tag name published prerelease; do
        [[ -z "$tag" ]] && continue
        tag=$(tsv_unescape "$tag")
        name=$(trim "$(tsv_unescape "$name")")
        [[ -n "$name" ]] || name=$(trim "$(api_tag_subject "$tag")")
        printf '%s\037%s\037%s\037%s\n' "$tag" "$name" "$published" "$prerelease"
    done <<< "$rows"
}

# Rows from a releases page on stdin: tag (as in its link), title, first date, pre-release flag.
parse_release_rows() {
    # One <section id="release-..."> per release: its title link, first ISO date and labels.
    awk '
        function flush() {
            if (tag != "") print tag "\037" name "\037" date "\037" pre
            tag = ""; name = ""; date = ""; pre = "false"
        }
        /<section id="release-/ { flush(); insec = 1 }
        insec && tag == "" && match($0, /href="\/[^"]+\/releases\/tag\/[^"]+"[^>]*class="Link--primary Link">[^<]*</) {
            link = substr($0, RSTART, RLENGTH)
            t = link; sub(/^href="\/[^"]+\/releases\/tag\//, "", t); sub(/".*/, "", t)
            n = link; sub(/^[^>]*>/, "", n); sub(/<$/, "", n)
            tag = t; name = n
        }
        insec && date == "" && match($0, /<relative-time[^>]*datetime="[0-9-]+T[0-9:]+Z"/) {
            d = substr($0, RSTART, RLENGTH); sub(/.*datetime="/, "", d); sub(/"$/, "", d)
            date = d
        }
        insec && /class="Label Label--warning[^"]*">Pre-release</ { pre = "true" }
        END { flush() }
    '
}

releases_from_web() {
    local page
    page=$(fetch_page "https://github.com/$REPO/releases")
    [[ -n "$page" ]] || return 1

    local rows
    rows=$(printf '%s' "$page" | parse_release_rows) || true

    local tag name published prerelease
    while IFS=$'\037' read -r tag name published prerelease; do
        [[ -z "$tag" ]] && continue
        printf '%s\037%s\037%s\037%s\n' "$(url_decode "$tag")" "$(trim "$(html_decode "$name")")" \
            "$published" "$prerelease"
    done <<< "$rows"
}

releases_json() {
    local rows
    if ! rows=$(releases_from_api); then
        if ! rows=$(releases_from_web); then
            echo "gft: could not fetch releases for $REPO" >&2
            exit 1
        fi
    fi

    json_setup
    local n=$J_NL s=$J_SEP
    if [[ -z "$rows" ]]; then
        printf '[]\n'
        return 0
    fi

    printf '[%s' "$n"
    local tag name published prerelease first=true
    while IFS=$'\037' read -r tag name published prerelease; do
        [[ -z "$tag" ]] && continue
        [[ "$prerelease" == true ]] || prerelease=false
        [[ -n "$name" ]] || name="$tag"
        $first || printf ',%s' "$n"
        first=false
        printf '%s{%s' "$J_I1" "$n"
        printf '%s"tag"%s%s,%s' "$J_I2" "$s" "$(json_str "$tag")" "$n"
        printf '%s"name"%s%s,%s' "$J_I2" "$s" "$(json_str "$name")" "$n"
        printf '%s"published_at"%s%s,%s' "$J_I2" "$s" "$(json_str_or_null "$published")" "$n"
        printf '%s"prerelease"%s%s%s' "$J_I2" "$s" "$prerelease" "$n"
        printf '%s}' "$J_I1"
    done <<< "$rows"
    printf '%s]\n' "$n"
}

list_releases() {
    if [[ "${MODE_JSON:-false}" == true ]]; then
        releases_json
        return 0
    fi

    local releases_url="https://github.com/$REPO/releases"
    local response
    response=$(fetch_page "$releases_url")

    if [[ -z "$response" ]]; then
        echo -e "${RED}${SYM_FAIL} Could not fetch releases page${NC}"
        return 1
    fi

    local all_tags
    all_tags=$(echo "$response" \
        | grep -oP 'href="/[^"]+/releases/tag/\K[^"]+' \
        | grep -v '^#' \
        | awk '!seen[$0]++')

    if [[ -z "$all_tags" ]]; then
        echo -e "${YELLOW}${SYM_FAIL} No releases found for $REPO${NC}"
        return 0
    fi

    echo
    echo -e "${YELLOW}${SYM_BULLET} Releases ($REPO)${NC}"
    echo

    local count=0
    while IFS= read -r tag; do
        ((count++)) || true
        printf "  ${SYM_TEE}${SYM_DASH} ${CYAN}%s${NC}\n" "$tag"
    done <<< "$all_tags"

    echo
    echo -e "  ${GREEN}${count} release(s) shown${NC} ${SYM_ARROW} https://github.com/$REPO/releases"
    if [[ "${MODE_PRE:-false}" != true ]]; then
        echo -e "  ${CYAN}Tip:${NC} use ${YELLOW}--pre${NC} to include pre-releases when resolving latest"
    fi
}

# ─── Plain output ────────────────────────────────────────────────────

# What --plain refuses to print, matched on bytes (C locale): invalid UTF-8, Cf, C1 and line separators.
PLAIN_UTF8=$'^([ -~]|[\xc2-\xdf][\x80-\xbf]|\xe0[\xa0-\xbf][\x80-\xbf]|[\xe1-\xec\xee\xef][\x80-\xbf][\x80-\xbf]|\xed[\x80-\x9f][\x80-\xbf]|\xf0[\x90-\xbf][\x80-\xbf][\x80-\xbf]|[\xf1-\xf3][\x80-\xbf][\x80-\xbf][\x80-\xbf]|\xf4[\x80-\x8f][\x80-\xbf][\x80-\xbf])*$'
PLAIN_HIDDEN=$'\xc2[\x80-\x9f]|\xc2\xad|\xd8[\x80-\x85\x9c]|\xdb\x9d|\xdc\x8f|\xe0\xa2[\x90\x91]|\xe0\xa3\xa2|\xe1\xa0\x8e|\xe2\x80[\x8b-\x8f\xa8-\xae]|\xe2\x81[\xa0-\xaf]|\xef\xbb\xbf|\xef\xbf[\xb9-\xbb]|\xf0\x91\x82\xbd|\xf0\x91\x83\x8d|\xf0\x93\x90[\xb0-\xbf]|\xf0\x9b\xb2[\xa0-\xa3]|\xf0\x9d\x85[\xb3-\xba]|\xf3\xa0[\x80-\xbf]'

# Decode what a page shows for a name: HTML entities, then percent-encoding.
plain_decode() {
    url_decode "$(html_decode "$1")"
}

# True when the decoded name $1 may be printed; $2 is its encoded form, which may not hold %00-%1f or %7f.
plain_ok() {
    local LC_ALL=C name="$1" raw="${2:-}"
    [[ "$raw" != *\&* ]] || raw=$(html_decode "$raw")
    [[ -n "$name" ]] || return 1
    [[ ! "$raw" =~ %[01][0-9a-fA-F] ]] || return 1
    [[ ! "$raw" =~ %[7][fF] ]] || return 1
    [[ "$name" != *[[:cntrl:]]* ]] || return 1
    [[ "$name" =~ $PLAIN_UTF8 ]] || return 1
    [[ ! "$name" =~ $PLAIN_HIDDEN ]] || return 1
    return 0
}

# A tag that cannot be taken for a range, a branch or the latest release.
plain_tag_ok() {
    local lower
    lower=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
    case "$lower" in
        latest|main|master) return 1 ;;
        *..*) return 1 ;;
    esac
    return 0
}

# The newest release: a tag on stdout. Fails with 1 when there is none, 2 on a network error.
plain_latest_tag() {
    local out rc=0 tag page
    if [[ "$MODE_PRE" != true ]]; then
        out=$(curl_page -o /dev/null -w '%{url_effective}' "https://github.com/$REPO/releases/latest") || rc=$?
        [[ $rc -eq 0 ]] || return 2
        tag=$(printf '%s' "$out" | grep -oP '/releases/tag/\K[^/?]+') || true
        if [[ -n "$tag" ]]; then
            printf '%s' "$tag"
            return 0
        fi
    fi
    page=$(cache_fetch "https://github.com/$REPO/releases") || return 2
    tag=$(printf '%s' "$page" | grep -o 'href="[^"]*/releases/tag/[^"]*"' | head -1 \
        | sed 's/.*\/tag\///; s/".*//') || true
    [[ -n "$tag" ]] || return 1
    printf '%s' "$(html_decode "$tag")"
}

# --releases --plain: "tag<TAB>date" for the first page (10 at most), newest first, "prerelease" after the date.
plain_releases() {
    local page rc=0
    page=$(cache_fetch "https://github.com/$REPO/releases") || rc=$?
    if [[ $rc -ne 0 ]]; then
        echo "gft: could not fetch the releases of $REPO" >&2
        return 1
    fi

    local rows
    rows=$(printf '%s' "$page" | parse_release_rows | head -n 50) || true
    if [[ -z "$rows" ]]; then
        # A page whose layout is not recognised still has its tag links: no dates, no pre-release flag.
        rows=$(printf '%s' "$page" | grep -oP 'href="/[^"]+/releases/tag/\K[^"#]+' | awk '!seen[$0]++' \
            | head -10 | sed 's/$/\o037\o037\o037false/') || true
        [[ -z "$rows" ]] || echo "gft: release page layout not recognised, dates are missing" >&2
    fi

    local tag name date pre decoded seen=$'\n' count=0 n=0
    while IFS=$'\037' read -r tag name date pre; do
        [[ -n "$tag" ]] || continue
        if (( ++n % 20 == 0 )) && ! plain_budget > /dev/null; then
            echo "gft: out of time, the list is cut short" >&2
            break
        fi
        [[ "$pre" != true ]] || [[ "$MODE_PRE" == true ]] || continue
        decoded=$(plain_decode "$tag")
        plain_ok "$decoded" "$tag" || continue
        plain_tag_ok "$decoded" || continue
        [[ "$seen" != *$'\n'"$decoded"$'\n'* ]] || continue
        seen+="$decoded"$'\n'
        date="${date%%T*}"
        [[ "$date" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || date=""
        if [[ "$pre" == true ]]; then
            printf '%s\t%sprerelease\n' "$decoded" "${date:+$date }"
        else
            printf '%s\t%s\n' "$decoded" "$date"
        fi
        ((count++)) || true
        [[ $count -lt 10 ]] || break
    done <<< "$rows"
}

# --assets --plain: one file name per line; --detect puts the recommended ones first, marked in a second column.
plain_assets() {
    local assets rc=0
    assets=$(get_assets) || rc=$?
    if [[ $rc -eq 2 ]]; then
        echo "gft: could not fetch the assets of $REPO $(printable "$TAG")" >&2
        return 1
    fi

    local path raw name key n=0 nrec=0 noth=0 recommended="" others=""
    local -A seen=()
    while IFS= read -r path; do
        [[ -n "$path" ]] || continue
        if (( ++n % 50 == 0 )) && ! plain_budget > /dev/null; then
            echo "gft: out of time, the list is cut short" >&2
            break
        fi
        raw="${path##*/}"
        url_decode_var name "$raw" || continue
        plain_ok "$name" "$raw" || continue
        # A name that --asset would refuse is of no use to a caller.
        [[ "$name" != */* && "$name" != *\\* && "$name" != .* ]] || continue
        key="k:$name"
        [[ -z "${seen[$key]+x}" ]] || continue
        seen[$key]=1
        if [[ "$MODE_DETECT" == true ]] && highlight_match "$name" && auto_pick_ok "$name"; then
            recommended+="$name"$'\t'"recommended"$'\n'
            ((nrec++)) || true
            [[ $nrec -lt 200 ]] || break
        elif [[ $noth -lt 200 ]]; then
            others+="$name"$'\n'
            ((noth++)) || true
            [[ "$MODE_DETECT" == true || $noth -lt 200 ]] || break
        fi
    done <<< "$assets"

    printf '%s%s' "$recommended" "$others" | head -n 200
}

# ─── Platform detection ──────────────────────────────────────────────

detect_platform() {
    local os arch
    os=$(uname -s | tr '[:upper:]' '[:lower:]')
    arch=$(uname -m)

    case "$os" in
        linux)           OS_PATTERNS=("linux") ;;
        darwin)          OS_PATTERNS=("darwin" "macos" "mac" "osx" "apple") ;;
        mingw*|msys*|cygwin*) OS_PATTERNS=("windows" "win" "win64" "win32") ;;
        freebsd)         OS_PATTERNS=("freebsd") ;;
        *)               OS_PATTERNS=("$os") ;;
    esac

    case "$arch" in
        x86_64|amd64)    ARCH_PATTERNS=("amd64" "x86_64" "x64" "64bit") ;;
        aarch64|arm64)   ARCH_PATTERNS=("arm64" "aarch64") ;;
        armv7l|armhf)    ARCH_PATTERNS=("armv7" "armhf" "arm") ;;
        i686|i386)       ARCH_PATTERNS=("386" "i386" "i686" "x86" "32bit") ;;
        *)               ARCH_PATTERNS=("$arch") ;;
    esac
}

highlight_match() {
    local f="${1,,}" p os=false arch=false

    for p in "${OS_PATTERNS[@]}"; do
        if [[ "$f" == *"${p,,}"* ]]; then os=true; break; fi
    done
    for p in "${ARCH_PATTERNS[@]}"; do
        if [[ "$f" == *"${p,,}"* ]]; then arch=true; break; fi
    done

    $os && $arch
}

highlight_asset() {
    if highlight_match "$1"; then
        echo "match"
    fi
}

# ─── Release notes ───────────────────────────────────────────────────

show_release_notes() {
    # Try gh cli first for cleaner output
    if command -v gh &>/dev/null && gh auth status &>/dev/null 2>&1; then
        local notes
        notes=$(gh api "repos/$REPO/releases/tags/$TAG" --jq '.body' 2>/dev/null) || true
        if [[ -n "$notes" ]]; then
            echo
            echo -e "${YELLOW}${SYM_BULLET} Release Notes ($TAG)${NC}"
            local separator
            separator=$(printf "%0.s$(sym "$SYM_DASH")" {1..40})
            echo -e "${CYAN}${separator}${NC}"
            echo "$notes" | head -80
            echo -e "${CYAN}${separator}${NC}"
            return 0
        fi
    fi

    # Fallback: scrape the release page
    local url="https://github.com/$REPO/releases/tag/$TAG"
    local response
    response=$(fetch_page "$url")

    if [[ -z "$response" ]]; then
        echo -e "${RED}${SYM_FAIL} Could not fetch release page${NC}"
        return 1
    fi

    local notes
    notes=$(echo "$response" | \
        sed -n '/data-test-selector="body-content"/,/<\/div>/p' | \
        sed 's/<[^>]*>//g' | \
        sed 's/&amp;/\&/g; s/&lt;/</g; s/&gt;/>/g; s/&quot;/"/g' | \
        sed "s/&#39;/'/g" | \
        sed '/^[[:space:]]*$/d' | \
        head -80)

    if [[ -z "$notes" ]]; then
        echo -e "${YELLOW}${SYM_FAIL} No release notes available for $TAG${NC}"
        return 0
    fi

    echo
    echo -e "${YELLOW}${SYM_BULLET} Release Notes ($TAG)${NC}"
    local separator
    separator=$(printf "%0.s$(sym "$SYM_DASH")" {1..40})
    echo -e "${CYAN}${separator}${NC}"
    echo "$notes"
    echo -e "${CYAN}${separator}${NC}"
}

# ─── JSON output ─────────────────────────────────────────────────────

# Schema 1 (see README): the same keys whether the data comes from the API (gh) or the web pages.
JSON_SCHEMA=1

# Compact on one line when stdout is not a terminal (scripts parse it), indented otherwise.
json_setup() {
    if [[ -t 1 ]]; then
        J_NL=$'\n' J_I1="  " J_I2="    " J_I3="      " J_SEP=": "
    else
        J_NL="" J_I1="" J_I2="" J_I3="" J_SEP=":"
    fi
}

# Quote a string as a JSON string literal.
json_str() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    s="${s//[[:cntrl:]]/}"
    printf '"%s"' "$s"
}

# Quote a string, or print null when it is empty.
json_str_or_null() {
    if [[ -n "$1" ]]; then json_str "$1"; else printf 'null'; fi
}

html_decode() {
    local s="$1"
    s="${s//&lt;/<}"
    s="${s//&gt;/>}"
    s="${s//&quot;/\"}"
    s="${s//&#39;/\'}"
    s="${s//&#x27;/\'}"
    s="${s//&amp;/&}"
    printf '%s' "$s"
}

# Decode the %XX of $2 into the variable $1: a lone % stays, %00 stays written out and fails.
url_decode_var() {
    local _s="$2" _o="" _b _rc=0
    while [[ "$_s" == *%* ]]; do
        _o+="${_s%%%*}"
        _s="${_s#*%}"
        if [[ "$_s" =~ ^[0-9A-Fa-f]{2} ]]; then
            if [[ "${_s:0:2}" == "00" ]]; then
                _o+="%00"
                _rc=1
            else
                printf -v _b '%b' "\\x${_s:0:2}"
                _o+="$_b"
            fi
            _s="${_s:2}"
        else
            _o+="%"
        fi
    done
    printf -v "$1" '%s' "$_o$_s"
    return "$_rc"
}

url_decode() {
    local _r
    url_decode_var _r "$1" || true
    printf '%s' "$_r"
}

trim() {
    local s="$1"
    s="${s#"${s%%[![:space:]]*}"}"
    s="${s%"${s##*[![:space:]]}"}"
    printf '%s' "$s"
}

# Title GitHub shows for an untitled release (unsigned annotated tag subject).
api_tag_subject() {
    local sha
    sha=$(gh api "repos/$REPO/git/ref/tags/$1" \
        --jq 'select(.object.type == "tag") | .object.sha' 2>/dev/null) || return 0
    [[ -n "$sha" ]] || return 0
    gh api "repos/$REPO/git/tags/$sha" \
        --jq 'select(.verification.reason == "unsigned") | .message | split("\n")[0]' \
        2>/dev/null || true
}

gh_ready() {
    command -v gh &>/dev/null && gh auth status &>/dev/null
}

# Run a gh api query whose jq filter emits @tsv rows, with \037 as separator.
gh_tsv() {
    local endpoint="$1" filter="$2" out
    out=$(gh api "$endpoint" --jq "$filter" 2>/dev/null) || return 1
    printf '%s\n' "$out" | tr '\t' '\037'
}

# Undo the escaping of a gh @tsv field.
tsv_unescape() {
    printf '%b' "$1"
}

# Release fields, filled by release_from_api or release_from_web.
R_NAME="" R_PUBLISHED="" R_PRERELEASE=false R_SOURCE=""
A_NAMES=() A_URLS=() A_DIGESTS=()

release_from_api() {
    gh_ready || return 1

    local rows
    rows=$(gh_tsv "repos/$REPO/releases/tags/$TAG" \
        '([.name // "", .published_at // "", (.prerelease | tostring)] | @tsv),
         (.assets | sort_by(.name)[] | [.name, .browser_download_url, .digest // ""] | @tsv)') \
        || return 1
    [[ -n "$rows" ]] || return 1

    local first=true name url digest published prerelease
    A_NAMES=() A_URLS=() A_DIGESTS=()
    while IFS=$'\037' read -r name url digest; do
        if $first; then
            published="$url" prerelease="$digest"
            R_NAME=$(trim "$(tsv_unescape "$name")")
            [[ -n "$R_NAME" ]] || R_NAME=$(trim "$(api_tag_subject "$TAG")")
            R_PUBLISHED="$published"
            R_PRERELEASE="$prerelease"
            first=false
            continue
        fi
        A_NAMES+=("$(tsv_unescape "$name")")
        A_URLS+=("$(tsv_unescape "$url")")
        A_DIGESTS+=("$digest")
    done <<< "$rows"

    [[ "$R_PRERELEASE" == true ]] || R_PRERELEASE=false
    R_SOURCE="api"
}

release_from_web() {
    local page
    page=$(fetch_page "https://github.com/$REPO/releases/tag/$TAG")

    # A release page has a visible title; a bare git tag or a 404 page does not.
    local title
    title=$(printf '%s' "$page" \
        | grep -oE '<h1 data-view-component="true" class="[^"]*d-inline">[^<]*</h1>' \
        | head -1 | sed 's/<[^>]*>//g') || true
    if [[ -z "$title" ]] && ! grep -qE '<h1 data-view-component="true" class="[^"]*d-inline">' \
        <<< "$page"; then
        return 1
    fi

    R_NAME=$(trim "$(html_decode "$title")")
    # The first ISO datetime on a release page is its publication date.
    R_PUBLISHED=$(printf '%s' "$page" \
        | grep -oE '<relative-time[^>]*datetime="[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:]{8}Z"' \
        | head -1 | sed 's/.*datetime="//; s/"$//') || true
    if grep -qE 'class="Label Label--warning[^"]*">Pre-release<' <<< "$page"; then
        R_PRERELEASE=true
    else
        R_PRERELEASE=false
    fi

    # One <li> per asset, holding its download link and, when GitHub has one, its digest.
    local assets_page rows
    assets_page=$(fetch_page "https://github.com/$REPO/releases/expanded_assets/$TAG")
    rows=$(printf '%s' "$assets_page" | awk '
        /<li/ { if (href != "") print href "\037" digest; href = ""; digest = "" }
        match($0, /href="\/[^"]+\/releases\/download\/[^"]+"/) {
            href = substr($0, RSTART + 6, RLENGTH - 7)
        }
        match($0, /sha256:[0-9a-f]+/) { if (digest == "") digest = substr($0, RSTART, RLENGTH) }
        END { if (href != "") print href "\037" digest }
    ' | sort -t$'\037' -k1,1 -u) || true

    local path digest name
    local -a entries=()
    A_NAMES=() A_URLS=() A_DIGESTS=()
    while IFS=$'\037' read -r path digest; do
        [[ -z "$path" ]] && continue
        name=$(url_decode "${path##*/}")
        # The API percent-encodes "+" in download URLs; the page keeps it raw in file names.
        entries+=("$name"$'\037'"https://github.com${path//+/%2B}"$'\037'"$digest")
    done <<< "$rows"

    # Sort by decoded name, as the API path does.
    if [[ ${#entries[@]} -gt 0 ]]; then
        while IFS=$'\037' read -r name path digest; do
            A_NAMES+=("$name")
            A_URLS+=("$path")
            A_DIGESTS+=("$digest")
        done < <(printf '%s\n' "${entries[@]}" | LC_ALL=C sort -t$'\037' -k1,1)
    fi

    R_SOURCE="web"
}

output_json() {
    if [[ "${NO_RELEASE:-false}" == true ]]; then
        echo "gft: no release found for $REPO" >&2
        exit 1
    fi

    if [[ "$TAG" == *%* ]]; then
        TAG=$(url_decode "$TAG")
        build_urls
    fi

    if ! release_from_api && ! release_from_web; then
        echo "gft: release not found: $REPO $TAG" >&2
        exit 1
    fi

    # A release without a title shows its tag on GitHub; do the same on both paths.
    [[ -n "$R_NAME" ]] || R_NAME="$TAG"

    json_setup
    local n=$J_NL s=$J_SEP
    printf '{%s' "$n"
    printf '%s"schema"%s%s,%s' "$J_I1" "$s" "$JSON_SCHEMA" "$n"
    printf '%s"repository"%s%s,%s' "$J_I1" "$s" "$(json_str "$REPO")" "$n"
    printf '%s"tag"%s%s,%s' "$J_I1" "$s" "$(json_str "$TAG")" "$n"
    printf '%s"name"%s%s,%s' "$J_I1" "$s" "$(json_str "$R_NAME")" "$n"
    printf '%s"published_at"%s%s,%s' "$J_I1" "$s" "$(json_str_or_null "$R_PUBLISHED")" "$n"
    printf '%s"prerelease"%s%s,%s' "$J_I1" "$s" "$R_PRERELEASE" "$n"
    printf '%s"release_url"%s%s,%s' "$J_I1" "$s" "$(json_str "$TAG_URL")" "$n"
    printf '%s"repo_url"%s%s,%s' "$J_I1" "$s" "$(json_str "$REPO_URL")" "$n"
    printf '%s"zip_url"%s%s,%s' "$J_I1" "$s" "$(json_str "$ZIP_URL")" "$n"
    printf '%s"tarball_url"%s%s,%s' "$J_I1" "$s" "$(json_str "$TARBALL_URL")" "$n"
    printf '%s"source"%s%s,%s' "$J_I1" "$s" "$(json_str "$R_SOURCE")" "$n"

    if [[ ${#A_NAMES[@]} -eq 0 ]]; then
        printf '%s"assets"%s[]%s' "$J_I1" "$s" "$n"
    else
        printf '%s"assets"%s[%s' "$J_I1" "$s" "$n"
        local i last=$(( ${#A_NAMES[@]} - 1 ))
        for i in "${!A_NAMES[@]}"; do
            printf '%s{%s' "$J_I2" "$n"
            printf '%s"name"%s%s,%s' "$J_I3" "$s" "$(json_str "${A_NAMES[i]}")" "$n"
            printf '%s"url"%s%s,%s' "$J_I3" "$s" "$(json_str "${A_URLS[i]}")" "$n"
            printf '%s"digest"%s%s%s' "$J_I3" "$s" "$(json_str_or_null "${A_DIGESTS[i]}")" "$n"
            printf '%s}' "$J_I2"
            [[ $i -lt $last ]] && printf ','
            printf '%s' "$n"
        done
        printf '%s]%s' "$J_I1" "$n"
    fi
    printf '}\n'
}

# ─── Checksum verification ───────────────────────────────────────────

# Print the command that hashes with SHA-<bits> ("sha256sum", "shasum -a 256", ...), or nothing.
sha_cmd() {
    if command -v "sha${1}sum" &>/dev/null; then
        echo "sha${1}sum"
    elif command -v shasum &>/dev/null; then
        echo "shasum -a $1"
    else
        echo ""
    fi
}

# Print the asset path (from the list $2) whose decoded file name equals $1, ignoring case.
find_asset_named() {
    local want path name
    want=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
    while IFS= read -r path; do
        [[ -n "$path" ]] || continue
        name=$(url_decode "${path##*/}" | tr '[:upper:]' '[:lower:]')
        if [[ "$name" == "$want" ]]; then
            printf '%s\n' "$path"
            return 0
        fi
    done <<< "$2"
    return 1
}

# Print the asset paths (from the list $2) whose decoded file name is exactly $1.
find_asset_exact() {
    local path name found=""
    while IFS= read -r path; do
        [[ -n "$path" ]] || continue
        url_decode_var name "${path##*/}" || continue
        if [[ "$name" == "$1" ]]; then
            found+="$path"$'\n'
        fi
    done <<< "$2"
    [[ -n "$found" ]] || return 1
    printf '%s' "$found"
}

# Find the checksum file of $1 (a decoded file name) among the asset paths $2.
find_checksum_asset() {
    local filename="$1"
    local assets="$2"
    local candidate path name

    for candidate in "${filename}.sha256" "${filename}.sha256sum" "${filename}.sha512" \
        "SHA256SUMS" "checksums.txt" "SHASUMS256.txt" "sha256sums.txt"; do
        if path=$(find_asset_named "$candidate" "$assets"); then
            echo "$path"
            return 0
        fi
    done

    # Any list of checksums of the release; never the checksum file of another file.
    while IFS= read -r path; do
        [[ -n "$path" ]] || continue
        name=$(url_decode "${path##*/}" | tr '[:upper:]' '[:lower:]')
        case "$name" in
            *checksums*|*sha256sums*|*sha512sums*|*shasums*)
                echo "$path"
                return 0
                ;;
        esac
    done <<< "$assets"
    return 0
}

# Print the hash that the checksum file $1 gives for the file name $2; a lone hash counts only when $3 is true.
checksum_for() {
    tr -d '\r' < "$1" | GFT_CK_NAME="$2" awk -v single="$3" '
        BEGIN { name = ENVIRON["GFT_CK_NAME"] }
        NF == 0 { next }
        {
            line = $0
            if (line ~ /^SHA(256|512) \(.*\) = [0-9A-Fa-f]+$/) {
                h = line; sub(/.* = /, "", h)
                f = line; sub(/^SHA(256|512) \(/, "", f); sub(/\) = [0-9A-Fa-f]+$/, "", f)
                if (f == name) { print h; found = 1; exit }
                next
            }
            h = $1
            f = line; sub(/^[^ \t]+[ \t]+/, "", f)
            if (f == line) {
                if (single == "true" && h ~ /^[0-9A-Fa-f]+$/) { lone = h; nlone++ }
                next
            }
            sub(/^\*/, "", f); sub(/^\.\//, "", f)
            if (f == name) { print h; found = 1; exit }
        }
        END { if (!found && nlone == 1) print lone }'
}

# Check the file $1 against the checksum file at the asset path $2, where it is listed as $3 (integrity only).
verify_checksum() {
    local file="$1" checksum_path="$2" name="$3"
    local checksum_url="https://github.com${checksum_path}"

    echo -e "${SYM_ARROW} Verifying checksum..."

    local tmp_checksum
    tmp_checksum=$(mktemp)
    if ! curl -fsL --max-time 10 "$checksum_url" -o "$tmp_checksum"; then
        rm -f "$tmp_checksum"
        echo -e "${RED}${SYM_FAIL} Could not download the checksum file${NC}"
        return 1
    fi

    local single=false
    case "$(url_decode "${checksum_path##*/}" | tr '[:upper:]' '[:lower:]')" in
        "$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]')".sha*) single=true ;;
    esac
    local expected_hash
    expected_hash=$(checksum_for "$tmp_checksum" "$name" "$single") || true
    rm -f "$tmp_checksum"

    if [[ -z "$expected_hash" ]]; then
        echo -e "${RED}${SYM_FAIL} $(printable "$name") is not in the checksum list${NC}"
        return 1
    fi
    expected_hash=$(printf '%s' "$expected_hash" | tr '[:upper:]' '[:lower:]')

    local bits
    case "${#expected_hash}" in
        64) bits=256 ;;
        128) bits=512 ;;
        *) bits="" ;;
    esac
    if [[ -z "$bits" ]] || [[ ! "$expected_hash" =~ ^[0-9a-f]+$ ]]; then
        echo -e "${RED}${SYM_FAIL} The checksum of $(printable "$name") is not a SHA-256 or SHA-512 value${NC}"
        return 1
    fi

    local cmd
    cmd=$(sha_cmd "$bits")
    if [[ -z "$cmd" ]]; then
        echo -e "${RED}${SYM_FAIL} No sha${bits}sum or shasum found, cannot verify the download${NC}"
        return 1
    fi

    local actual_hash
    # $cmd is unquoted on purpose ("shasum -a 256"); the path stays one word.
    actual_hash=$($cmd -- "$file" 2>/dev/null | awk '{print $1}') || true
    actual_hash=$(printf '%s' "$actual_hash" | tr '[:upper:]' '[:lower:]')

    if [[ -z "$actual_hash" ]]; then
        echo -e "${RED}${SYM_FAIL} Could not compute the checksum of the download${NC}"
        return 1
    elif [[ "$actual_hash" == "$expected_hash" ]]; then
        echo -e "${GREEN}${SYM_OK} Checksum verified${NC} (integrity, not authenticity)"
    else
        rm -f -- "$file"
        echo -e "${RED}${SYM_FAIL} Checksum mismatch, the downloaded file was removed${NC}"
        echo -e "  Expected: ${CYAN}${expected_hash}${NC}"
        echo -e "  Got:      ${RED}${actual_hash}${NC}"
        return 1
    fi
}

# ─── Direct asset download ───────────────────────────────────────────

# Download $1 to $2, never over an existing file without --force; $3 and $4 (checksum asset, name) verify it first.
fetch_file() {
    local url="$1" dest="$2" checksum_path="${3:-}" name="${4:-}"
    if [[ -d "$dest" ]]; then
        echo -e "${RED}${SYM_FAIL} Cannot write ${dest}: it is a folder${NC}"
        return 1
    fi
    if [[ -e "$dest" || -L "$dest" ]] && [[ "$FORCE" != true ]]; then
        echo -e "${RED}${SYM_FAIL} ${dest} already exists, use --force to replace it${NC}"
        return 1
    fi
    local part
    if ! part=$(mktemp -- "$dest.gft-part.XXXXXX" 2>/dev/null); then
        echo -e "${RED}${SYM_FAIL} Cannot write ${dest}${NC}"
        return 1
    fi
    PART_FILE="$part"
    if ! curl -fL --progress-bar "$url" -o "$part"; then
        rm -f -- "$part"
        PART_FILE=""
        echo -e "${RED}${SYM_FAIL} Download failed${NC}"
        return 1
    fi
    if [[ -n "$checksum_path" ]] && ! verify_checksum "$part" "$checksum_path" "$name"; then
        rm -f -- "$part"
        PART_FILE=""
        return 1
    fi
    chmod "$(printf '%o' $(( 8#666 & ~8#$(umask) )))" "$part" 2>/dev/null || true
    if ! mv -f -- "$part" "$dest"; then
        rm -f -- "$part"
        PART_FILE=""
        echo -e "${RED}${SYM_FAIL} Cannot write ${dest}${NC}"
        return 1
    fi
    PART_FILE=""
}

# True for a file that --install may pick on its own: an archive or a binary, not a package, sum or signature.
auto_pick_ok() {
    case "${1,,}" in
        *.tar.gz|*.tgz|*.zip) return 0 ;;
        *.deb|*.rpm|*.apk|*.pkg|*.msi|*.msix|*.appx|*.dmg|*.snap|*.flatpak) return 1 ;;
        *.sha256|*.sha256sum|*.sha512|*.sha512sum|*.sha1|*.sha1sum|*.md5|*.md5sum|*.sum|*.b3|*.blake3) return 1 ;;
        *.sig|*.sig.b64|*.asc|*.minisig|*.p7s|*.pem|*.crt|*.cert|*.cer|*.der|*.pub|*.bundle|*.att|*.attestation) return 1 ;;
        *.sbom|*.sbom.json|*.sbom.xml|*.cdx.json|*-sbom|*.spdx|*.spdx.json|*.sigstore|*.sigstore.json) return 1 ;;
        *.intoto.jsonl|*checksums*|*sha256sums*|*sha512sums*|*shasums*) return 1 ;;
        *.tar|*.tar.*|*.tbz|*.tbz2|*.txz|*.tzst|*.7z|*.rar|*.gz|*.xz|*.bz2|*.zst) return 1 ;;
        *.txt|*.json|*.md|*.sh.sig) return 1 ;;
    esac
    return 0
}

download_asset() {
    local pattern="$1"
    local assets
    assets=$(get_assets) || true

    if [[ -z "$assets" ]]; then
        echo -e "${RED}${SYM_FAIL} No release assets found${NC}"
        return 1
    fi

    local matches
    if [[ -n "$ASSET_NAME" ]]; then
        matches=$(find_asset_exact "$ASSET_NAME" "$assets") || true
    else
        matches=$(echo "$assets" | grep -i -e "$pattern") || true
    fi

    local match_count=0
    if [[ -n "$matches" ]]; then
        match_count=$(echo "$matches" | wc -l)
    fi

    if [[ $match_count -eq 0 ]]; then
        if [[ -n "$ASSET_NAME" ]]; then
            echo -e "${RED}${SYM_FAIL} No asset named '$(printable "$ASSET_NAME")'${NC}"
        else
            echo -e "${RED}${SYM_FAIL} No assets found matching '$(printable "$pattern")'${NC}"
        fi
        echo -e "  Use ${YELLOW}--assets${NC} to list available assets"
        return 1
    elif [[ $match_count -gt 1 ]]; then
        if [[ -n "$ASSET_NAME" ]]; then
            echo -e "${RED}${SYM_FAIL} Several assets are named '$(printable "$ASSET_NAME")'${NC}" >&2
            return 2
        fi
        if [[ ! -t 0 ]]; then
            {
                echo -e "${YELLOW}${SYM_BULLET} Multiple assets match '$(printable "$pattern")':${NC}"
                while IFS= read -r match; do
                    echo -e "  $(printable "$(url_decode "$(basename "$match")")")"
                done <<< "$matches"
                echo -e "  Name one of them with ${YELLOW}--asset=NAME${NC}"
            } >&2
            return 2
        fi
        echo -e "${YELLOW}${SYM_BULLET} Multiple assets match '${pattern}':${NC}"
        local i=0
        while IFS= read -r match; do
            ((i++)) || true
            echo -e "  ${BLUE}${i}${NC}) $(basename "$match")"
        done <<< "$matches"
        echo
        local selection
        read -p "Select (1-${i}): " -r selection
        if [[ ! "$selection" =~ ^[0-9]+$ ]] || (( selection < 1 || selection > i )); then
            echo -e "${RED}${SYM_FAIL} Invalid selection${NC}"
            return 1
        fi
        matches=$(echo "$matches" | sed -n "${selection}p")
    fi

    local url="https://github.com${matches}"
    local filename name dest
    filename=$(basename "$matches")
    name=$(url_decode "$filename")
    # An exact name is saved under that name; a pattern keeps the name of the link.
    [[ -n "$ASSET_NAME" ]] && filename="$ASSET_NAME"
    if [[ -z "$filename" || "$filename" == "." || "$filename" == ".." ]]; then
        echo -e "${RED}${SYM_FAIL} The asset has no usable file name${NC}"
        return 1
    fi
    dest=$(dest_path "$filename")

    local checksum_path=""
    if [[ "${MODE_VERIFY:-false}" == true ]]; then
        checksum_path=$(find_checksum_asset "$name" "$assets")
        if [[ -z "$checksum_path" ]]; then
            echo -e "${RED}${SYM_FAIL} No checksum file found for $(printable "$name")${NC}"
            return 1
        fi
    fi

    echo -e "${SYM_ARROW} Downloading ${CYAN}$(printable "$filename")${NC}..."
    if fetch_file "$url" "$dest" "$checksum_path" "$name"; then
        echo -e "${GREEN}${SYM_OK} Downloaded: $(printable "$dest")${NC}"
    else
        return 1
    fi
}

# Where a downloaded file goes: the --dir folder, or the working directory.
dest_path() {
    if [[ -n "$DL_DIR" ]]; then
        printf '%s/%s' "${DL_DIR%/}" "$1"
    else
        printf '%s' "$1"
    fi
}

# File name of a source archive: the tag made harmless (no slash, no leading dot) and the extension $1.
source_name() {
    local t="${TAG//[^A-Za-z0-9._@+-]/_}"
    t="${t#"${t%%[!.]*}"}"
    [[ -n "$t" ]] || t="source"
    printf '%.200s.%s' "$t" "$1"
}

# ─── Install asset ───────────────────────────────────────────────────

# Where --install puts the binary: --user means ~/.local/bin, otherwise the first writable choice.
find_install_dir() {
    if [[ "$MODE_USER" == true ]]; then
        mkdir -p "$HOME/.local/bin" || return 1
        echo "$HOME/.local/bin"
    elif [ -w "/usr/local/bin" ]; then
        echo "/usr/local/bin"
    elif mkdir -p "$HOME/.local/bin" 2>/dev/null; then
        echo "$HOME/.local/bin"
    else
        mkdir -p "$HOME/bin"
        echo "$HOME/bin"
    fi
}

install_asset() {
    local pattern="${1:-}"

    local assets
    assets=$(get_assets) || true

    if [[ -z "$assets" ]]; then
        echo -e "${RED}${SYM_FAIL} No release assets found${NC}"
        return 1
    fi

    local selected_path=""

    if [[ -n "$ASSET_NAME" ]]; then
        selected_path=$(find_asset_exact "$ASSET_NAME" "$assets") || true
        if [[ "$selected_path" == *$'\n'* ]]; then
            echo -e "${RED}${SYM_FAIL} Several assets are named '$(printable "$ASSET_NAME")'${NC}" >&2
            return 2
        fi
    elif [[ -n "$pattern" ]]; then
        selected_path=$(echo "$assets" | grep -i -e "$pattern" | head -1) || true
    else
        if [[ "${MODE_DETECT:-false}" != true ]]; then
            detect_platform
        fi
        while IFS= read -r asset_path; do
            local fname
            fname=$(basename "$asset_path")
            if [[ "$(highlight_asset "$fname")" == "match" ]] && auto_pick_ok "$(url_decode "$fname")"; then
                selected_path="$asset_path"
                break
            fi
        done <<< "$assets"
    fi

    if [[ -z "$selected_path" ]]; then
        if [[ -n "$ASSET_NAME" ]]; then
            echo -e "${RED}${SYM_FAIL} No asset named '$(printable "$ASSET_NAME")'${NC}"
        else
            echo -e "${RED}${SYM_FAIL} No suitable asset found${NC}"
        fi
        echo -e "  Use ${YELLOW}--detect${NC} to see what's available, or ${YELLOW}--get <pattern>${NC} to specify"
        return 1
    fi

    local filename name
    filename=$(basename "$selected_path")
    name=$(url_decode "$filename")
    local url="https://github.com${selected_path}"

    # The download and its extraction stay in a temporary folder: only the binary is written out.
    local tmp_dir
    if ! tmp_dir=$(mktemp -d); then
        echo -e "${RED}${SYM_FAIL} Cannot create a temporary folder${NC}"
        return 1
    fi
    INSTALL_TMP="$tmp_dir"
    trap 'rm -rf -- "$INSTALL_TMP"' EXIT
    local archive="$tmp_dir/$filename"
    local extract_dir="$tmp_dir/extract"
    mkdir "$extract_dir"

    echo -e "${SYM_ARROW} Downloading ${CYAN}$(printable "$name")${NC}..."
    if ! curl -fL --progress-bar "$url" -o "$archive"; then
        echo -e "${RED}${SYM_FAIL} Download failed${NC}"
        return 1
    fi
    echo -e "${GREEN}${SYM_OK} Downloaded: $(printable "$name")${NC}"

    if [[ "${MODE_VERIFY:-false}" == true ]]; then
        local checksum_path
        checksum_path=$(find_checksum_asset "$name" "$assets")
        if [[ -n "$checksum_path" ]]; then
            verify_checksum "$archive" "$checksum_path" "$name" || return 1
        else
            echo -e "${RED}${SYM_FAIL} No checksum file found for $(printable "$name")${NC}"
            return 1
        fi
    fi

    local binary_path=""

    case "${filename,,}" in
        *.tar.gz|*.tgz)
            echo -e "${SYM_ARROW} Extracting archive..."
            if ! tar xzf "$archive" -C "$extract_dir" 2>/dev/null; then
                echo -e "${RED}${SYM_FAIL} Extraction failed${NC}"
                return 1
            fi
            ;;
        *.zip)
            echo -e "${SYM_ARROW} Extracting archive..."
            if ! command -v unzip &>/dev/null; then
                echo -e "${RED}${SYM_FAIL} unzip is required to extract .zip files${NC}"
                return 1
            fi
            if ! unzip -q "$archive" -d "$extract_dir" 2>/dev/null; then
                echo -e "${RED}${SYM_FAIL} Extraction failed${NC}"
                return 1
            fi
            ;;
        *)
            binary_path="$archive"
            chmod +x "$binary_path"
            ;;
    esac

    if [[ -z "$binary_path" ]]; then
        local repo_name
        repo_name=$(echo "$REPO" | cut -d'/' -f2 | tr '[:upper:]' '[:lower:]')
        binary_path=$(find "$extract_dir" -type f -name "$repo_name" 2>/dev/null | head -1) || true
        if [[ -z "$binary_path" ]]; then
            binary_path=$(find "$extract_dir" -type f -perm /111 \
                ! -path "*/__MACOSX/*" ! -name "*.sh" ! -name "*.md" \
                2>/dev/null | head -1) || true
        fi
        if [[ -z "$binary_path" ]]; then
            echo -e "${RED}${SYM_FAIL} No executable binary found in archive${NC}"
            return 1
        fi
    fi

    local install_dir
    if [[ -n "$DL_DIR" ]]; then
        install_dir="${DL_DIR%/}"
    else
        install_dir=$(find_install_dir) || {
            echo -e "${RED}${SYM_FAIL} Cannot create the install folder${NC}"
            return 1
        }
    fi
    local binary_name
    binary_name=$(basename "$binary_path")

    # An installed binary is replaced (an update, with or without --force) by a rename, so a busy or read-only file is no obstacle.
    echo -e "${SYM_ARROW} Installing ${CYAN}$(printable "$binary_name")${NC} to ${CYAN}${install_dir:-/}${NC}..."
    local target="$install_dir/$binary_name" staged=""
    if [[ -d "$target" ]]; then
        echo -e "${RED}${SYM_FAIL} Cannot install ${target}: it is a folder${NC}"
        return 1
    fi
    if staged=$(mktemp -- "$install_dir/.$binary_name.gft-new.XXXXXX" 2>/dev/null) \
        && cp -- "$binary_path" "$staged" \
        && chmod "$(printf '%o' $(( 8#777 & ~8#$(umask) )))" "$staged" \
        && mv -f -- "$staged" "$target"; then
        echo -e "${GREEN}${SYM_OK} Installed: ${install_dir}/$(printable "$binary_name")${NC}"
    else
        [[ -z "$staged" ]] || rm -f -- "$staged"
        echo -e "${RED}${SYM_FAIL} Installation failed (permission denied?)${NC}"
        return 1
    fi

    trap - EXIT
    rm -rf "$tmp_dir"
}

# ─── Open in browser ─────────────────────────────────────────────────

open_url() {
    local url="$1"

    if grep -qi microsoft /proc/version 2>/dev/null; then
        if command -v wslview &>/dev/null; then
            wslview "$url" 2>/dev/null &
        else
            cmd.exe /c start "$url" 2>/dev/null &
        fi
        echo -e "${GREEN}${SYM_OK} Opening ${CYAN}${url}${NC}"
        return 0
    fi

    local os
    os=$(uname -s)
    case "$os" in
        Darwin)
            open "$url" 2>/dev/null &
            echo -e "${GREEN}${SYM_OK} Opening ${CYAN}${url}${NC}"
            ;;
        Linux)
            if [[ -z "${DISPLAY:-}" ]] && [[ -z "${WAYLAND_DISPLAY:-}" ]]; then
                echo -e "${YELLOW}${SYM_FAIL} No display detected, cannot open browser${NC}"
                echo -e "  URL: ${CYAN}${url}${NC}"
                return 1
            fi
            xdg-open "$url" 2>/dev/null &
            echo -e "${GREEN}${SYM_OK} Opening ${CYAN}${url}${NC}"
            ;;
        *)
            echo -e "${YELLOW}${SYM_FAIL} Cannot open browser on this platform${NC}"
            echo -e "  URL: ${CYAN}${url}${NC}"
            return 1
            ;;
    esac
}

# ─── Version comparison ──────────────────────────────────────────────

compare_releases() {
    local from="$1" to="$2"
    # The page lists tags percent-encoded (astro%407): compare them decoded.
    [[ "$from" == *%* ]] && from=$(url_decode "$from")
    [[ "$to" == *%* ]] && to=$(url_decode "$to")

    echo -e "${YELLOW}${SYM_BULLET} Comparing: ${CYAN}$(printable "$from")${NC} ${SYM_ARROW} ${CYAN}$(printable "$to")${NC}"
    echo

    # Fetch releases page to find tags in range
    local releases_page
    releases_page=$(fetch_page "https://github.com/$REPO/releases")

    if [[ -n "$releases_page" ]]; then
        local all_tags
        all_tags=$(echo "$releases_page" | grep -oP '/releases/tag/\K[^"]+' | head -50)

        if [[ -n "$all_tags" ]]; then
            local in_range=false
            local count=0
            echo -e "${BLUE}Releases in range:${NC}"
            while IFS= read -r tag; do
                tag=$(url_decode "$tag")
                if [[ "$tag" == "$to" ]]; then in_range=true; fi
                if $in_range; then
                    ((count++)) || true
                    echo -e "  ${SYM_TEE}${SYM_DASH} ${CYAN}$(printable "$tag")${NC}"
                    if [[ "$tag" == "$from" ]]; then break; fi
                fi
            done <<< "$all_tags"

            if [[ $count -eq 0 ]]; then
                echo -e "  ${YELLOW}Could not find both tags on the first releases page${NC}"
            fi
        fi
    fi

    echo
    echo -e "${YELLOW}${SYM_BULLET} Compare on GitHub:${NC}"
    echo -e "  ${CYAN}https://github.com/$REPO/compare/$(tag_url "$from")...$(tag_url "$to")${NC}"
}

# ─── Interactive download ────────────────────────────────────────────

prompt_download() {
    echo
    read -p "$(echo -e "${YELLOW}${SYM_ARROW} Download? ${NC}(z)ip, (t)ar.gz, (n)o [n]: ")" -n 1 -r
    echo

    local dest
    if [[ $REPLY =~ ^[Zz]$ ]]; then
        echo -e "${SYM_ARROW} Downloading ZIP archive..."
        dest=$(dest_path "$(source_name zip)")
        if fetch_file "$ZIP_URL" "$dest"; then
            echo -e "${GREEN}${SYM_OK} Downloaded: ${dest}${NC}"
        else
            return 1
        fi
    elif [[ $REPLY =~ ^[Tt]$ ]]; then
        echo -e "${SYM_ARROW} Downloading TAR.GZ archive..."
        dest=$(dest_path "$(source_name tar.gz)")
        if fetch_file "$TARBALL_URL" "$dest"; then
            echo -e "${GREEN}${SYM_OK} Downloaded: ${dest}${NC}"
        else
            return 1
        fi
    fi
}

# ─── Git stash management ────────────────────────────────────────────

STASH_YES=false

stash_require_repo() {
    if ! git rev-parse --is-inside-work-tree &>/dev/null; then
        echo -e "${RED}${SYM_FAIL} Not a git repository${NC}"
        echo -e "  Run ${YELLOW}gft stash${NC} from inside a git repository"
        return 1
    fi
}

stash_list() {
    stash_require_repo || return 1

    local stashes
    stashes=$(git stash list --format='%gd%x09%gs' 2>/dev/null) || true

    if [[ -z "$stashes" ]]; then
        echo -e "${YELLOW}${SYM_FAIL} No stashes found${NC}"
        return 0
    fi

    echo
    echo -e "${YELLOW}${SYM_BULLET} Stashes${NC}"
    echo

    local total n=0 ref subj
    total=$(echo "$stashes" | wc -l)

    while IFS=$'\t' read -r ref subj; do
        [[ -z "$ref" ]] && continue
        ((n++)) || true
        if [[ $n -eq $total ]]; then
            echo -e "  ${SYM_CORNER}${SYM_DASH} ${CYAN}${ref}${NC}  ${subj}"
        else
            echo -e "  ${SYM_TEE}${SYM_DASH} ${CYAN}${ref}${NC}  ${subj}"
        fi
    done <<< "$stashes"

    echo
    echo -e "  ${GREEN}${total} stash(es)${NC}"
}

stash_show() {
    stash_require_repo || return 1

    local n="${1:-0}"
    local ref="stash@{${n}}"

    if ! git rev-parse --verify --quiet "$ref" >/dev/null 2>&1; then
        echo -e "${RED}${SYM_FAIL} No such stash: ${ref}${NC}"
        return 1
    fi

    git stash show -p "$ref"
}

stash_drop() {
    stash_require_repo || return 1

    local n="${1:-}"
    if [[ -z "$n" ]]; then
        echo -e "${RED}${SYM_FAIL} Usage: gft stash drop <index>${NC}"
        return 1
    fi

    local ref="stash@{${n}}"

    if ! git rev-parse --verify --quiet "$ref" >/dev/null 2>&1; then
        echo -e "${RED}${SYM_FAIL} No such stash: ${ref}${NC}"
        return 1
    fi

    if [[ "$STASH_YES" != true ]]; then
        printf "${CYAN}Drop ${ref}? [y/N]:${NC} "
        read -r reply < /dev/tty
        case "$reply" in
            y|Y|yes|YES|oui|OUI) ;;
            *) echo -e "${BLUE}Cancelled.${NC}"; return 0 ;;
        esac
    fi

    if git stash drop "$ref"; then
        echo -e "${GREEN}${SYM_OK} Dropped ${ref}${NC}"
    else
        echo -e "${RED}${SYM_FAIL} Failed to drop ${ref}${NC}"
        return 1
    fi
}

stash_clean() {
    stash_require_repo || return 1

    local count
    count=$(git stash list 2>/dev/null | wc -l | tr -d ' ')

    if [[ "$count" -eq 0 ]]; then
        echo -e "${YELLOW}${SYM_FAIL} No stashes found${NC}"
        return 0
    fi

    if [[ "$STASH_YES" != true ]]; then
        echo -e "${RED}This will delete all ${count} stash(es).${NC}"
        printf "${CYAN}Continue? [y/N]:${NC} "
        read -r reply < /dev/tty
        case "$reply" in
            y|Y|yes|YES|oui|OUI) ;;
            *) echo -e "${BLUE}Cancelled.${NC}"; return 0 ;;
        esac
    fi

    if git stash clear; then
        echo -e "${GREEN}${SYM_OK} Cleared ${count} stash(es)${NC}"
    else
        echo -e "${RED}${SYM_FAIL} Failed to clear stashes${NC}"
        return 1
    fi
}

stash_help() {
    echo "Usage: gft stash [action] [options]"
    echo
    echo "Manage git stashes in the current repository."
    echo
    echo "Actions:"
    echo "  list (default)  List stashes in the current repo"
    echo "  show [n]        Show the diff of stash n (default: 0)"
    echo "  drop <n>        Drop stash n"
    echo "  clean           Delete all stashes (alias: clear)"
    echo
    echo "Options:"
    echo "  -y, --yes       Skip confirmation prompts"
    echo
    echo "Aliases: ls=list  diff=show  rm=drop"
}

cmd_stash() {
    local action="${1:-list}"
    shift || true

    STASH_YES=false
    local args=()
    for a in "$@"; do
        case "$a" in
            -y|--yes) STASH_YES=true ;;
            *) args+=("$a") ;;
        esac
    done

    case "$action" in
        list|ls)
            stash_list
            ;;
        show|diff)
            stash_show "${args[0]:-0}"
            ;;
        drop|rm)
            stash_drop "${args[0]:-}"
            ;;
        clean|clear)
            stash_clean
            ;;
        -h|--help|help)
            stash_help
            ;;
        *)
            echo -e "${RED}${SYM_FAIL} Unknown stash action: ${action}${NC}"
            echo
            stash_help
            return 1
            ;;
    esac
}

# ─── Argument parsing ────────────────────────────────────────────────

REPO=""
TAG="latest"
NO_RELEASE=false
MSG_FD=1
DL_DIR=""
MODE_QUIET=false
MODE_ASSETS=false
MODE_DETECT=false
MODE_GET=false
MODE_NOTES=false
MODE_JSON=false
MODE_COMPARE=false
MODE_PRE=false
MODE_LIST=false
MODE_SOURCE=""
MODE_VERIFY=false
MODE_INSTALL=false
MODE_OPEN=false
NO_CACHE=false
GET_PATTERN=""
ASSET_NAME=""
FORCE=false
MODE_USER=false
TAG_FROM=""
TAG_TO=""

# Commands are only recognised as the first argument.
case "${1:-}" in
    update)
        setup_colors
        self_upgrade
        exit $?
        ;;
    delete|uninstall)
        setup_colors
        self_uninstall
        exit $?
        ;;
    stash)
        setup_colors
        shift
        cmd_stash "$@"
        exit $?
        ;;
esac

# Usage error: message on MSG_FD, exit status 2.
usage_error() {
    echo -e "${RED}${SYM_FAIL} $1${NC}" >&2
    exit 2
}

# A value from the command line, with anything that is not printable made harmless.
mask_hidden() {
    local LC_ALL=C s="$1"
    while [[ "$s" =~ $PLAIN_HIDDEN ]]; do
        s="${s/"${BASH_REMATCH[0]}"/?}"
    done
    printf '%s' "$s"
}

# For echo -e: the backslashes are doubled so that they are printed as they are.
printable() {
    local s="${1//[^[:print:]]/?}"
    s=$(mask_hidden "$s")
    printf '%s' "${s//\\/\\\\}"
}

# Print true or false for a boolean option value (true|false|1|0|yes|no|on|off, any case).
parse_bool() {
    case "${1,,}" in
        true|1|yes|on) echo true ;;
        false|0|no|off) echo false ;;
        *) return 1 ;;
    esac
}

# Set the variable $1 from the boolean value $3 of the option $2.
set_bool() {
    local value
    value=$(parse_bool "$3") || usage_error "$2: invalid value '$(printable "$3")' (use true or false)"
    printf -v "$1" '%s' "$value"
}

# $2 is 2 for the --source=VALUE form, a usage error; the separate form keeps its status 1.
set_source() {
    MODE_SOURCE="$1"
    if [[ -z "$MODE_SOURCE" ]]; then
        [[ "${2:-}" != 2 ]] || usage_error "--source requires an argument: zip or tar"
        echo -e "${RED}${SYM_FAIL} --source requires an argument: zip or tar${NC}" >&"$MSG_FD"
        exit 1
    fi
    case "$MODE_SOURCE" in
        zip|tar|tar.gz|tarball) ;;
        *)
            [[ "${2:-}" != 2 ]] || usage_error "--source argument must be 'zip', 'tar' or 'tar.gz'"
            echo -e "${RED}${SYM_FAIL} --source argument must be 'zip' or 'tar'${NC}" >&"$MSG_FD"
            exit 1
            ;;
    esac
}

# $2 is 2 for the --dir=VALUE form, a usage error; the separate form keeps its status 1.
set_dir() {
    DL_DIR="$1"
    if [[ -z "$DL_DIR" ]]; then
        [[ "${2:-}" != 2 ]] || usage_error "--dir requires a folder argument"
        echo -e "${RED}${SYM_FAIL} --dir requires a folder argument${NC}" >&"$MSG_FD"
        exit 1
    fi
}

# An asset name to match exactly: a plain file name, not a path and not a hidden file.
set_asset() {
    ASSET_NAME="$1"
    if [[ -z "$ASSET_NAME" ]] || [[ "$ASSET_NAME" == .* ]] || [[ "$ASSET_NAME" == */* ]] \
        || [[ "$ASSET_NAME" == *\\* ]] || [[ "$ASSET_NAME" == *[[:cntrl:]]* ]]; then
        usage_error "--asset needs a plain file name (no path, no leading dot): '$(printable "$ASSET_NAME")'"
    fi
}

add_positional() {
    if [ -z "$REPO" ]; then
        REPO="$1"
    elif [[ "$1" == *".."* ]]; then
        TAG_FROM="${1%%..*}"
        TAG_TO="${1##*..}"
        MODE_COMPARE=true
    else
        TAG="$1"
    fi
}

# With --json or --plain, usage errors from the loop below must not reach stdout either.
PLAIN_SEEN=false
for arg in "$@"; do
    [[ "$arg" == "--" ]] && break
    if [[ "$arg" == "--json" || "$arg" == "--plain" || "$arg" == --json=* || "$arg" == --plain=* ]]; then
        MSG_FD=2
        NO_COLOR=1
        setup_colors
        if [[ "$arg" == "--plain" ]]; then
            PLAIN_SEEN=true
            # One deadline for the whole run, counted from here.
            PLAIN_END=$(( $(now_ms) + 1000 * $( [[ "${GFT_PLAIN_TIMEOUT:-}" =~ ^[1-9][0-9]{0,3}$ ]] && echo "$GFT_PLAIN_TIMEOUT" || echo 8 ) ))
        fi
    fi
done

# Colors off before any message, as NO_COLOR and a piped stdout ask.
setup_colors

while [[ $# -gt 0 ]]; do
    case $1 in
        --)
            # End of options: everything after is a repository or tag.
            shift
            while [[ $# -gt 0 ]]; do
                add_positional "$1"
                shift
            done
            ;;
        -h|--help)
            show_help
            exit 0
            ;;
        -v|--version)
            echo "gft $VERSION"
            exit 0
            ;;
        --check-update)
            setup_colors
            check_update
            exit $?
            ;;
        --upgrade)
            setup_colors
            self_upgrade
            exit $?
            ;;
        --no-color)
            NO_COLOR=1
            shift
            ;;
        --no-cache)
            NO_CACHE=true
            shift
            ;;
        --no-cache=*)
            set_bool NO_CACHE --no-cache "${1#*=}"
            shift
            ;;
        --open)
            MODE_OPEN=true
            shift
            ;;
        --install)
            MODE_INSTALL=true
            shift
            ;;
        --checksum|--verify)
            MODE_VERIFY=true
            shift
            ;;
        --checksum=*|--verify=*)
            set_bool MODE_VERIFY "${1%%=*}" "${1#*=}"
            shift
            ;;
        --source)
            set_source "${2:-}"
            shift 2
            ;;
        --source=*)
            set_source "${1#*=}" 2
            shift
            ;;
        --releases|--list)
            MODE_LIST=true
            shift
            ;;
        --pre|--prerelease)
            MODE_PRE=true
            shift
            ;;
        --pre=*|--prerelease=*)
            set_bool MODE_PRE "${1%%=*}" "${1#*=}"
            shift
            ;;
        --clear-cache)
            setup_colors
            if [[ -d "$CACHE_DIR" ]]; then
                clear_cache
                echo -e "${GREEN}${SYM_OK} Cache cleared${NC}"
            else
                echo -e "${CYAN}${SYM_DOT} Cache is already empty${NC}"
            fi
            exit 0
            ;;
        -q|--quiet)
            MODE_QUIET=true
            NO_COLOR=1
            shift
            ;;
        --assets)
            MODE_ASSETS=true
            shift
            ;;
        --detect)
            MODE_DETECT=true
            MODE_ASSETS=true
            shift
            ;;
        --get)
            MODE_GET=true
            GET_PATTERN="${2:-}"
            if [[ -z "$GET_PATTERN" ]]; then
                echo -e "${RED}${SYM_FAIL} --get requires a pattern argument${NC}" >&"$MSG_FD"
                exit 1
            fi
            shift 2
            ;;
        --dir)
            set_dir "${2:-}"
            shift 2
            ;;
        --dir=*)
            set_dir "${1#*=}" 2
            # The shell expands a leading ~ only in the separate form, so do it here.
            case "$DL_DIR" in
                "~") DL_DIR="$HOME" ;;
                "~/"*) DL_DIR="$HOME/${DL_DIR#"~/"}" ;;
            esac
            [[ -n "$DL_DIR" ]] || usage_error "--dir: ~ needs a home folder"
            shift
            ;;
        --asset)
            set_asset "${2:-}"
            shift 2
            ;;
        --asset=*)
            set_asset "${1#*=}"
            shift
            ;;
        --force)
            FORCE=true
            shift
            ;;
        --plain)
            PLAIN=true
            shift
            ;;
        --user)
            MODE_USER=true
            shift
            ;;
        --notes)
            MODE_NOTES=true
            shift
            ;;
        --json)
            MODE_JSON=true
            NO_COLOR=1
            shift
            ;;
        -*)
            echo -e "${RED}${SYM_FAIL} Unknown option: $(printable "$1")${NC}" >&"$MSG_FD"
            show_help >&"$MSG_FD"
            [[ "$PLAIN_SEEN" == true ]] && exit 2
            exit 1
            ;;
        *)
            add_positional "$1"
            shift
            ;;
    esac
done

# Apply color settings after parsing
setup_colors

# Messages that are not the requested output go to stderr in JSON and plain modes.
if [[ "$MODE_JSON" == true ]] || [[ "$PLAIN" == true ]]; then
    MSG_FD=2
fi

if [[ "$PLAIN" == true ]]; then
    plain_conflict=""
    [[ "$MODE_JSON" != true ]] || plain_conflict="--json"
    [[ -n "$plain_conflict" || "$MODE_QUIET" != true ]] || plain_conflict="-q"
    [[ -n "$plain_conflict" || "$MODE_INSTALL" != true ]] || plain_conflict="--install"
    [[ -n "$plain_conflict" || "$MODE_GET" != true ]] || plain_conflict="--get"
    [[ -n "$plain_conflict" || "$MODE_NOTES" != true ]] || plain_conflict="--notes"
    [[ -n "$plain_conflict" || "$MODE_OPEN" != true ]] || plain_conflict="--open"
    [[ -n "$plain_conflict" || "$MODE_COMPARE" != true ]] || plain_conflict="a range of tags"
    [[ -n "$plain_conflict" || -z "$MODE_SOURCE" ]] || plain_conflict="--source"
    [[ -n "$plain_conflict" || -z "$ASSET_NAME" ]] || plain_conflict="--asset"
    [[ -z "$plain_conflict" ]] || usage_error "--plain cannot be combined with $plain_conflict"
    if [[ "$MODE_LIST" != true && "$MODE_ASSETS" != true ]]; then
        usage_error "--plain needs --releases or --assets"
    fi
    if [[ "$MODE_LIST" == true && "$MODE_ASSETS" == true ]]; then
        usage_error "--plain cannot list releases and assets at once"
    fi
fi

# Validate repository argument
if [ -z "$REPO" ]; then
    [[ "$PLAIN" != true ]] || usage_error "--plain needs a repository"
    show_help
    exit 0
fi

if [[ ! "$REPO" =~ ^[a-zA-Z0-9._-]+/[a-zA-Z0-9._-]+$ ]] || [[ "${REPO%%/*}" =~ ^\.+$ ]] \
    || [[ "${REPO##*/}" =~ ^\.\.?$ ]]; then
    {
        echo -e "${RED}${SYM_FAIL} Invalid repository format: '$(printable "$REPO")'${NC}"
        echo -e "  Expected: ${YELLOW}username/repository${NC}"
        echo -e "  Example:  ${YELLOW}nodejs/node${NC}"
    } >&"$MSG_FD"
    [[ "$PLAIN" == true ]] && exit 2
    exit 1
fi

# Conflict checks
if [[ -n "$MODE_SOURCE" ]] && [[ "$MODE_GET" == true ]]; then
    echo -e "${RED}${SYM_FAIL} --source and --get cannot be used together${NC}" >&"$MSG_FD"
    exit 1
fi

if [[ -n "$ASSET_NAME" ]] && [[ "$MODE_GET" == true ]]; then
    usage_error "--asset and --get cannot be used together"
fi
if [[ -n "$ASSET_NAME" ]] && [[ -n "$MODE_SOURCE" ]]; then
    usage_error "--asset and --source cannot be used together"
fi
if [[ "$MODE_VERIFY" == true ]] && [[ -n "$MODE_SOURCE" ]]; then
    usage_error "--checksum does not go with --source: a source archive has no checksum file"
fi
if [[ "$MODE_USER" == true ]] && [[ "$MODE_INSTALL" != true ]]; then
    usage_error "--user only goes with --install"
fi
if [[ "$MODE_USER" == true ]] && [[ -n "$DL_DIR" ]]; then
    usage_error "--user and --dir cannot be used together"
fi

# --dir is never created: a missing folder is more likely a typo than a wish.
if [[ -n "$DL_DIR" ]] && { [[ ! -d "$DL_DIR" ]] || [[ ! -w "$DL_DIR" ]]; }; then
    echo -e "${RED}${SYM_FAIL} --dir: not a writable folder: ${DL_DIR}${NC}" >&"$MSG_FD"
    exit 1
fi

# ─── Main flow ───────────────────────────────────────────────────────

# Init platform detection if needed
if [[ "$MODE_DETECT" == true ]]; then
    detect_platform
fi

if [[ "$MODE_QUIET" != true ]] && [[ "$MODE_JSON" != true ]] && [[ "$PLAIN" != true ]]; then
    echo -e "${SYM_ARROW} Looking up ${YELLOW}$REPO${NC} (${CYAN}$TAG${NC})..."
fi

# Check repo exists
check_repository_exists

# Plain output: nothing but the entries on stdout
if [[ "$PLAIN" == true ]]; then
    if [[ "$MODE_LIST" == true ]]; then
        plain_releases
        exit $?
    fi
    if [[ "$TAG" == "latest" ]]; then
        rc=0
        TAG=$(plain_latest_tag) || rc=$?
        if [[ $rc -eq 2 ]]; then
            echo "gft: could not look up the latest release of $REPO" >&2
            exit 1
        fi
        [[ $rc -eq 0 ]] || exit 0
    fi
    plain_assets
    exit $?
fi

# Handle list mode
if [[ "$MODE_LIST" == true ]]; then
    list_releases
    exit 0
fi

# Handle compare mode separately
if [[ "$MODE_COMPARE" == true ]]; then
    echo
    compare_releases "$TAG_FROM" "$TAG_TO"
    exit 0
fi

# Resolve tag
resolve_tag

# Build URLs
build_urls

# Open in browser (combinable, does not exit)
if [[ "$MODE_OPEN" == true ]]; then
    open_url "$TAG_URL" >&"$MSG_FD"
fi

# Dispatch by mode
if [[ "$MODE_QUIET" == true ]]; then
    if [[ "$NO_RELEASE" == true ]]; then
        echo "gft: No release found for $REPO" >&2
        exit 1
    fi
    echo "$TAG"
    exit 0
fi

if [[ "$MODE_JSON" == true ]]; then
    output_json
    exit 0
fi

if [[ "$MODE_INSTALL" == true ]]; then
    install_asset "${GET_PATTERN:-}" || exit $?
    exit 0
fi

if [[ "$MODE_GET" == true ]] || [[ -n "$ASSET_NAME" ]]; then
    download_asset "$GET_PATTERN" || exit $?
    exit 0
fi

# Non-interactive source download
if [[ -n "$MODE_SOURCE" ]]; then
    dl_file=""
    case "$MODE_SOURCE" in
        zip)
            echo -e "${SYM_ARROW} Downloading ZIP source archive..."
            dl_file=$(dest_path "$(source_name zip)")
            fetch_file "$ZIP_URL" "$dl_file" || exit 1
            echo -e "${GREEN}${SYM_OK} Downloaded: ${dl_file}${NC}"
            ;;
        tar|tar.gz|tarball)
            echo -e "${SYM_ARROW} Downloading TAR.GZ source archive..."
            dl_file=$(dest_path "$(source_name tar.gz)")
            fetch_file "$TARBALL_URL" "$dl_file" || exit 1
            echo -e "${GREEN}${SYM_OK} Downloaded: ${dl_file}${NC}"
            ;;
    esac
    exit 0
fi

# Default display
display_info

# Append optional modes
if [[ "$MODE_ASSETS" == true ]]; then
    list_assets
fi

if [[ "$MODE_NOTES" == true ]]; then
    show_release_notes
fi

# Interactive download prompt (only in terminal, not piped)
if [[ -t 0 ]] && [[ "$MODE_ASSETS" != true ]] && [[ "$MODE_GET" != true ]] && [[ -z "$ASSET_NAME" ]]; then
    prompt_download
fi
